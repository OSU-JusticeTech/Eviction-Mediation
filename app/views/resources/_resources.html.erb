  <script>
    function initLandingPage() {
      // ---- Role selector ----
      const roleButtons = document.querySelectorAll(".lp-role-btn");
      const roleContents = document.querySelectorAll(".lp-role-content");

      roleButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          const role = btn.dataset.role;
          roleButtons.forEach(b => b.classList.toggle("is-active", b.dataset.role === role));
          roleContents.forEach(c => c.classList.toggle("is-active", c.dataset.role === role));
          // Re-init cards for the newly visible section
          initRoleCards(role);
        });
      });

      // ---- Card/panel init per role ----
      function initRoleCards(role) {
        const container = document.querySelector(`.lp-role-content[data-role="${role}"]`);
        if (!container) return;

        const cards  = container.querySelectorAll(".resx-card");
        const panels = container.querySelectorAll(".resx-panel");
        if (!cards.length || !panels.length) return;

        if (cards[0].dataset.initialized) return;
        cards[0].dataset.initialized = "true";

        function activate(panelKey) {
          cards.forEach(c => c.classList.toggle("is-active", c.dataset.panel === panelKey));
          panels.forEach(p => p.classList.toggle("is-active", p.id === "panel-" + panelKey));
        }

        activate(cards[0].dataset.panel);

        cards.forEach(card => {
          card.addEventListener("click", () => activate(card.dataset.panel));
        });
      }

      // Init the default active role (tenant)
      initRoleCards("tenant");
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLandingPage);
    } else {
      initLandingPage();
    }
    document.addEventListener("turbo:load", initLandingPage);
  </script>
