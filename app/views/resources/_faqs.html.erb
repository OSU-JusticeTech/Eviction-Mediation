<div class="faq-content">
  <h1>Frequently Asked Questions</h1>

  <!-- FAQ Category Tabs -->
  <div class="faq-tabs">
    <% @faqs.keys.each do |category| %>
      <a href="<%= resources_path(tab: params[:tab], category: category.parameterize) %>"
         class="<%= 'active' if params[:category] == category.parameterize %>">
        <%= category %>
      </a>
    <% end %>
  </div>

  <% selected_slug = params[:category].presence || @faqs.keys.first.to_s.parameterize %>
  <% selected_category = @faqs.keys.find { |category| category.parameterize == selected_slug } %>
  <% if selected_category %>
    <div class="accordion">
      <% @faqs[selected_category].each_with_index do |faq, index| %>
        <div class="accordion-item">
          <input type="checkbox" id="faq-<%= selected_slug %>-<%= index + 1 %>" class="accordion-toggle">
          <label for="faq-<%= selected_slug %>-<%= index + 1 %>" class="accordion-header">
            Q: <%= faq[:question] %>
          </label>
          <div class="accordion-content">
              <strong>A:</strong> <%= faq[:answer] %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No FAQs available for this category.</p>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const toggles = document.querySelectorAll('.accordion-toggle');

    toggles.forEach(toggle => {
      toggle.addEventListener('change', function () {
        // Close other accordions
        toggles.forEach(other => {
          if (other !== toggle) {
            other.checked = false;
          }
        });
      });
    });
  });
</script>
