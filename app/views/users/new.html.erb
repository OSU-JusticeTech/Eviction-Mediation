<!-- Sign Up Page -->
<div class="signup-page">
  <div class="signup-title">Eviction Mediation</div>

  <div class="signup-container">
    <!-- Banner -->
    <div class="signup-banner">
      <h1>Create your account</h1>
      <p>Join our platform to resolve rental disputes effectively</p>
    </div>

    <div class="signup-card">
      <h2> <i class="fa-solid fa-user-plus"></i> Sign Up</h2>
      <p class="signup-text"> Let's create your account. </p>

    <%= form_with model: @user, url: signup_path, local: true, data: { turbo: false, controller: "signup-disclaimer",
              action: "submit->signup-disclaimer#validate" }, class: "signup-form" do |f| %>
      <%# Error handling display #%>
      <% if @user.errors.any? %>
        <div class="error-summary">
          <h4>The following errors occured: </h4>
            <% @user.errors.full_messages.each do |msg| %>
              <span><%= msg %></span><br>
            <% end %>
        </div>
      <% end %>
      <!-- First Name -->
      <div class="input-group">
        <label for="user_FName">First Name</label>
        <div class="input-field">
          <i class="fa-solid fa-user"></i>
          <%= f.text_field :FName, placeholder: "Enter your first name", required: true, class: "signup-input" %>
        </div>
      </div>

      <!-- Last Name -->
      <div class="input-group">
        <label for="user_LName">Last Name</label>
        <div class="input-field">
          <i class="fa-solid fa-user"></i>
          <%= f.text_field :LName, placeholder: "Enter your last name", required: true, class: "signup-input" %>
        </div>
      </div>

      <!-- Email -->
      <div class="input-group">
        <label for="user_Email">Email</label>
        <div class="input-field">
          <i class="fa-solid fa-envelope"></i>
          <%= f.email_field :Email, placeholder: "youremail@example.com", required: true, class: "signup-input" %>
        </div>
        <% if @user.errors[:Email].any? %>
          <div class="error-text"><%= @user.errors[:Email].first %></div>
        <% end %>
      </div>

      <!-- Password -->
      <div class="input-group">
        <label for="user_password">Password</label>
        <div class="input-field">
          <i class="fa-solid fa-lock"></i>
          <%= f.password_field :password, placeholder: "Create a password", required: true, class: "signup-input" %>
        </div>
        <% if @user.errors[:password].any? %>
          <div class="error-text"><%= @user.errors[:password].first %></div>
        <% end %>
      </div>

      <!-- Password Confirmation -->
      <div class="input-group">
        <label for="user_password_confirmation">Confirm Password</label>
        <div class="input-field">
          <i class="fa-solid fa-lock"></i>
          <%= f.password_field :password_confirmation, placeholder: "Confirm your password", required: true, class: "signup-input" %>
        </div>
        <% if @user.errors[:password_confirmation].any? %>
          <div class="error-text"><%= @user.errors[:password_confirmation].first %></div>
        <% end %>
      </div>

      <label class="show-password-label">
        <input type="checkbox" id="show-password" aria-controls="user_password user_password_confirmation">
        Show Password
      </label>

      <!-- Role Selection -->
      <div class="role-selection">
        <p>Please select your role:</p>
        <label class="role-option">
          <%= f.radio_button :Role, "Tenant", id: "role_tenant", class: "signup-radio" %>
          Tenant
        </label>
        <label class="role-option">
          <%= f.radio_button :Role, "Landlord", id: "role_landlord", class: "signup-radio" %>
          Landlord
        </label>
      </div>

      <!-- Address Fields (Tenant) -->
      <div id="address-field" class="conditional-field">
        <div class="input-group">
          <label for="address-line-1">Address Line 1</label>
          <div class="input-field">
            <i class="fa-solid fa-map-marker-alt"></i>
            <%= f.text_field :AddressLine1, placeholder: "Street address", class: "signup-input", id: "address-line-1", autocomplete: "address-line1" %>
          </div>
        </div>

        <div class="input-group">
          <label for="address-line-2">Address Line 2 (Optional)</label>
          <div class="input-field">
            <i class="fa-solid fa-map-pin"></i>
            <%= f.text_field :AddressLine2, placeholder: "Apartment, suite, unit, etc.", class: "signup-input", id: "address-line-2", autocomplete: "address-line2" %>
          </div>
        </div>

        <div class="input-group">
          <label for="city">City</label>
          <div class="input-field">
            <i class="fa-solid fa-city"></i>
            <%= f.text_field :City, placeholder: "City", class: "signup-input", id: "city", autocomplete: "address-level2" %>
          </div>
        </div>

        <div class="input-group">
          <label for="state">State</label>
          <div class="input-field">
            <i class="fa-solid fa-flag-usa"></i>
            <%= f.select :State, options_for_select([
              ["Select a state", ""],
              ["Alabama", "Alabama"],
              ["Alaska", "Alaska"],
              ["Arizona", "Arizona"],
              ["Arkansas", "Arkansas"],
              ["California", "California"],
              ["Colorado", "Colorado"],
              ["Connecticut", "Connecticut"],
              ["Delaware", "Delaware"],
              ["Florida", "Florida"],
              ["Georgia", "Georgia"],
              ["Hawaii", "Hawaii"],
              ["Idaho", "Idaho"],
              ["Illinois", "Illinois"],
              ["Indiana", "Indiana"],
              ["Iowa", "Iowa"],
              ["Kansas", "Kansas"],
              ["Kentucky", "Kentucky"],
              ["Louisiana", "Louisiana"],
              ["Maine", "Maine"],
              ["Maryland", "Maryland"],
              ["Massachusetts", "Massachusetts"],
              ["Michigan", "Michigan"],
              ["Minnesota", "Minnesota"],
              ["Mississippi", "Mississippi"],
              ["Missouri", "Missouri"],
              ["Montana", "Montana"],
              ["Nebraska", "Nebraska"],
              ["Nevada", "Nevada"],
              ["New Hampshire", "New Hampshire"],
              ["New Jersey", "New Jersey"],
              ["New Mexico", "New Mexico"],
              ["New York", "New York"],
              ["North Carolina", "North Carolina"],
              ["North Dakota", "North Dakota"],
              ["Ohio", "Ohio"],
              ["Oklahoma", "Oklahoma"],
              ["Oregon", "Oregon"],
              ["Pennsylvania", "Pennsylvania"],
              ["Rhode Island", "Rhode Island"],
              ["South Carolina", "South Carolina"],
              ["South Dakota", "South Dakota"],
              ["Tennessee", "Tennessee"],
              ["Texas", "Texas"],
              ["Utah", "Utah"],
              ["Vermont", "Vermont"],
              ["Virginia", "Virginia"],
              ["Washington", "Washington"],
              ["West Virginia", "West Virginia"],
              ["Wisconsin", "Wisconsin"],
              ["Wyoming", "Wyoming"]
            ], @user.State), {}, class: "signup-input", id: "state", autocomplete: "address-level1" %>
          </div>
        </div>

        <div class="input-group">
          <label for="zip-code">ZIP Code</label>
          <div class="input-field">
            <i class="fa-solid fa-mail-bulk"></i>
            <%= f.text_field :ZipCode, placeholder: "12345 or 12345-6789", class: "signup-input", id: "zip-code", inputmode: "numeric", pattern: "\\d{5}(-\\d{4})?", title: "Use 5 digits or ZIP+4 (12345-6789)", autocomplete: "postal-code" %>
          </div>
        </div>
      </div>

      <!-- Company Name Field -->
      <div id="company-field" class="conditional-field">
        <div class="input-group">
          <label for="user_CompanyName">Company Name</label>
          <div class="input-field">
            <i class="fa-solid fa-building"></i>
            <%= f.text_field :CompanyName, placeholder: "Enter your company name", class: "signup-input" %>
          </div>
        </div>
      </div>

      <!-- Phone Number (Always Visible) -->
      <div class="input-group">
        <%= f.label :PhoneNumber, "Phone Number (Optional)", for: "phone-number" %>
        <div class="input-field">
          <i class="fa-solid fa-phone"></i>
          <%= f.telephone_field :PhoneNumber, placeholder: "(555) 555-1234", class: "signup-input", id: "phone-number", inputmode: "tel", pattern: "\\(\\d{3}\\) \\d{3}-\\d{4}", title: "Use format (123) 456-7890" %>
        </div>
      </div>

      <div class="disclaimer">
        <p class="disclaimer-instructions">
          Please read the
          <button type="button" class="disclaimer-link" aria-haspopup="dialog" aria-controls="legal-disclaimer"
                  data-signup-disclaimer-target="trigger" data-action="signup-disclaimer#open">Legal Disclaimer</button>
          before signing up.
        </p>
        <div class="disclaimer-consent">
          <%= f.check_box :ProfileDisclaimer, { required: true, data: { signup_disclaimer_target: "consent" } }, 'yes', 'no' %>
          <%= f.label :ProfileDisclaimer, "I have read and agree to the Legal Disclaimer" %>
        </div>

        <% if @user.errors[:ProfileDisclaimer].any? %>
          <div class="error-text"><%= @user.errors[:ProfileDisclaimer].first %></div>
        <% end %>
        <div id="terms-error" class="error-text" role="alert" hidden data-signup-disclaimer-target="error">
          You must open and read the Legal Disclaimer before signing up
        </div>
      </div>

      <dialog id="legal-disclaimer" class="modal-popup" aria-labelledby="signup-disclaimer-title"
              data-signup-disclaimer-target="dialog" data-action="close->signup-disclaimer#restoreFocus">
        <button type="button" class="close-popup" aria-label="Close legal disclaimer" autofocus
                data-action="signup-disclaimer#close">&times;</button>
        <h2 id="signup-disclaimer-title">Legal Disclaimer</h2>
        <%= render "shared/legal_disclaimer_text" %>
        <div class="disclaimer-actions">
          <button type="button" id="agreeButton" class="btn-primary" data-action="signup-disclaimer#agree">I Agree</button>
        </div>
      </dialog>

      <!-- Sign Up Button -->
      <%= f.submit "Sign Up", class: "signup-btn" %>
    <% end %>

    <p class="signup-text">Already have an account?
      <%= link_to "Log in", login_path, class: "signup-link" %></p>
    </div>

    <!-- Features Section -->
    <div class="features">
      <div class="features-grid">
        <div class="feature">
          <i class="fa-solid fa-scale-balanced"></i>
          <p>Early Mediation</p>
        </div>
        <div class="feature">
          <i class="fa-solid fa-comments"></i>
          <p>chat-based Communication</p>
        </div>
        <div class="feature">
          <i class="fa-solid fa-file-signature"></i>
          <p>Digital Agreements</p>
        </div>
        <div class="feature">
          <i class="fa-solid fa-calculator"></i>
          <p>Payment Planning</p>
        </div>
      </div>
      <p>Communicate early. Avoid court. Find fair solutions.</p>
    </div>
  </div>
</div>

<script>
  function formatPhoneDigitsToDisplay(digits) {
    const trimmed = digits.slice(0, 10);
    const area = trimmed.slice(0, 3);
    const middle = trimmed.slice(3, 6);
    const last = trimmed.slice(6, 10);

    if (trimmed.length === 0) return "";
    if (trimmed.length < 4) return `(${area}`;
    if (trimmed.length < 7) return `(${area}) ${middle}`;
    return `(${area}) ${middle}-${last}`;
  }

  function countDigits(str) {
    return (str.match(/\d/g) || []).length;
  }

  function caretIndexForDigitCount(formattedValue, digitCount) {
    if (digitCount <= 0) return 0;

    let seenDigits = 0;
    for (let i = 0; i < formattedValue.length; i += 1) {
      if (/\d/.test(formattedValue[i])) {
        seenDigits += 1;
        if (seenDigits >= digitCount) {
          return i + 1;
        }
      }
    }

    return formattedValue.length;
  }

  function setupPhoneFormatting() {
    const phoneInput = document.getElementById("phone-number");
    if (!phoneInput || phoneInput.dataset.phoneMaskBound === "true") return;

    phoneInput.dataset.phoneMaskBound = "true";

    phoneInput.addEventListener("keydown", function(event) {
      if (event.key !== "Backspace") return;
      if (this.selectionStart !== this.selectionEnd) return;

      const cursor = this.selectionStart;
      if (cursor <= 0) return;

      const previousChar = this.value[cursor - 1];
      if (previousChar && /\D/.test(previousChar)) {
        event.preventDefault();
        this.setSelectionRange(cursor - 1, cursor - 1);
      }
    });

    phoneInput.addEventListener("input", function() {
      const originalValue = this.value;
      const originalCursor = this.selectionStart || 0;
      const digitsBeforeCursor = countDigits(originalValue.slice(0, originalCursor));

      const digits = originalValue.replace(/\D/g, "").slice(0, 10);
      const formatted = formatPhoneDigitsToDisplay(digits);
      this.value = formatted;

      const newCursor = caretIndexForDigitCount(formatted, digitsBeforeCursor);
      this.setSelectionRange(newCursor, newCursor);
    });

    phoneInput.value = formatPhoneDigitsToDisplay(phoneInput.value.replace(/\D/g, "").slice(0, 10));
  }

  function setupAddressFormatting() {
    const stateInput = document.getElementById("state");
    const zipInput = document.getElementById("zip-code");

    if (zipInput && zipInput.dataset.addressMaskBound !== "true") {
      zipInput.dataset.addressMaskBound = "true";
      zipInput.addEventListener("input", function() {
        const cleaned = this.value.replace(/[^\d-]/g, "").replace(/-{2,}/g, "-");
        this.value = cleaned.slice(0, 10);
      });
    }
  }

  function toggleFields() {
    const tenantRadio = document.getElementById("role_tenant");
    const landlordRadio = document.getElementById("role_landlord");
    const addressField = document.getElementById("address-field");
    const companyField = document.getElementById("company-field");
    const tenantFields = [
      document.getElementById("address-line-1"),
      document.getElementById("city"),
      document.getElementById("state"),
      document.getElementById("zip-code")
    ].filter(Boolean);

    if (!tenantRadio || !landlordRadio || !addressField || !companyField) return;

    if (tenantRadio.checked) {
      addressField.style.display = "block";
      tenantFields.forEach((input) => { input.required = true; });
      companyField.style.display = "none";
      companyField.querySelector("input").required = false;
    } else if (landlordRadio.checked) {
      addressField.style.display = "none";
      tenantFields.forEach((input) => { input.required = false; });
      companyField.style.display = "block";
      companyField.querySelector("input").required = false;
    } else {
      addressField.style.display = "none";
      tenantFields.forEach((input) => { input.required = false; });
      companyField.style.display = "none";
    }
  }

  function setupToggleHandlers() {
    const tenantRadio = document.getElementById("role_tenant");
    const landlordRadio = document.getElementById("role_landlord");

    if (tenantRadio) tenantRadio.addEventListener("change", toggleFields);
    if (landlordRadio) landlordRadio.addEventListener("change", toggleFields);

    const showPassword = document.getElementById("show-password");
    const passwordFields = [
      document.getElementById("user_password"),
      document.getElementById("user_password_confirmation")
    ];
    if (showPassword && passwordFields.every(Boolean)) {
      showPassword.checked = false;
      passwordFields.forEach((field) => { field.type = "password"; });
      showPassword.onchange = () => {
        passwordFields.forEach((field) => { field.type = showPassword.checked ? "text" : "password"; });
      };
    }

    setupPhoneFormatting();
    setupAddressFormatting();
    toggleFields(); // initial setup
  }

  document.addEventListener("DOMContentLoaded", setupToggleHandlers);
  document.addEventListener("turbo:load", setupToggleHandlers); // for Turbo
</script>
