<div class="document-view-container">
  <% 
    # Determine back path based on context
    back_path = if @conversation
      # If document is part of a conversation, go back to messages
      case @user.Role
      when "Mediator"
        mediator_case_path(@conversation.ConversationID)
      when "Landlord"
        messages_path
      when "Tenant"
        messages_path
      else
        documents_path
      end
    else
      # Otherwise go back to documents
      case @user.Role
      when "Mediator"
        third_party_mediations_path
      else
        documents_path
      end
    end
    
    back_text = @conversation ? "Back to Messages" : "Back to Documents"
  %>

  <%= link_to back_path, class: "back-link" do %>
    <i class="fa-solid fa-arrow-left"></i> <%= back_text %>
  <% end %>

  <div class="document-header-card">
    <div class="header-content">
      <h1><%= @file.FileName %></h1>
      <div class="document-actions">
        <%= link_to download_file_path(@file.FileID), target: "_blank", class: "btn-document-action" do %>
          <i class="fa-solid fa-download"></i> <%= get_download_label(@file) %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @file.agreement_to_mediate? && !@editing_agreement %>
    <p><%= link_to "Data Privacy and Privacy Policy", resources_path(tab: "faqs", category: "data-privacy"), target: "_blank", rel: "noopener" %></p>
  <% end %>

  <% if @file.custom_resolution? && @file.agreement_terms["cr_additional_signers"] != "no" %>
    <p role="status"><%= CustomResolutionTerms::SIGNER_ERROR %></p>
  <% elsif @file.additional_pay_and_stay_signers? %>
    <p role="status"><%= PayAndStayTerms::ADDITIONAL_SIGNERS_NOTICE %></p>
  <% end %>

  <% if @conversation && @landlord && @tenant && @file.FileTypes == "html" && params[:view_mode] != 'simple' %>
    <% if @file.agreement_editable? && @can_suggest_agreement %>
      <div class="signature-status-card">
        <h2>Review Agreement</h2>
        <p>Review the document below. If a date, amount, or other term needs work, you can suggest changes below.</p>
      </div>
    <% end %>
    <!-- Signature Status Card -->
    <div class="signature-status-card" id="signature-status-card">
      <h2>Signature Status</h2>
      <div class="signature-grid">
        <% signers = { "Landlord" => @landlord, "Tenant" => @tenant }
           signers["Mediator"] = @mediator if @file.agreement_to_mediate? %>
        <% signers.each do |role, signer| %>
          <% signed = @file.public_send("#{role}Signature") %>
          <% signed_at = @file.public_send("#{role}SignedAt") %>
          <% name = signed && role == "Mediator" ? @file.MediatorSignatureName : AgreementToMediateTerms.account_name(signer) %>
          <div class="signature-party" data-signature-role="<%= role.downcase %>">
            <div class="party-label"><%= role %></div>
            <div class="party-name"><%= name.presence || "Awaiting assignment" %></div>
            <% if signed %>
              <div class="signature-status signed"><i class="fa-solid fa-check-circle"></i> Signed</div>
              <% if signed_at %>
                <div class="signature-timestamp"><%= signed_at.strftime("%B %d, %Y at %I:%M %p") %></div>
              <% end %>
            <% else %>
              <div class="signature-status pending"><i class="fa-regular fa-circle"></i> Awaiting signature</div>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @file.agreement_fully_executed? %>
        <div class="completion-banner">
          <i class="fa-solid fa-check-circle"></i>
          <strong>Document Fully Executed</strong> - All required signers have signed this agreement.
        </div>
      <% end %>
    </div>

  <% end %>

  <% if @editing_agreement && (@file.custom_resolution? || @file.agreement_to_mediate?) %>
    <%= render "documents/generation_editor", review_file: @file %>
  <% elsif @editing_agreement %>
    <div class="signature-status-card agreement-editor-guide" data-agreement-editor data-agreement-template="<%= @file.AgreementTemplate %>">
      <h2>Suggest Changes</h2>
      <p>Click a highlighted value in the document to edit it. Your edits are only a preview until you send them.</p>
      <p class="agreement-editor-count" data-agreement-edit-count role="status">No changes yet</p>
      <%= form_with url: update_review_document_path(@file.FileID), method: :patch, local: true,
                    data: { turbo: false }, html: { id: "agreement-editor-form" } do %>
        <%= hidden_field_tag :agreement_version, @file.AgreementVersion %>
        <% @editable_agreement_fields.each do |field| %>
          <% value = @file.agreement_terms[field] %>
          <%= hidden_field_tag field, @submitted_agreement_terms ? @submitted_agreement_terms[field] : value,
                               data: { agreement_term: field, agreement_original: value.to_s } %>
        <% end %>
        <div class="form-actions">
          <%= submit_tag "Finish & Send Suggested Changes", class: "agreement-action", disabled: true, data: { agreement_finish: true } %>
          <%= link_to "Cancel", view_file_path(@file.FileID), class: "agreement-cancel" %>
        </div>
      <% end %>
      <p class="agreement-editor-error" data-agreement-editor-error role="alert" <%= "hidden" unless @agreement_editor_error %>><%= @agreement_editor_error %></p>
    </div>
  <% end %>

  <% unless @editing_agreement && (@file.custom_resolution? || @file.agreement_to_mediate?) %>
    <div class="document-preview-card">
      <%= tag.iframe src: view_inline_document_path(@file.FileID, editable_preview: @editing_agreement ? 1 : nil),
            srcdoc: (@agreement_retry_preview && String.new(@agreement_retry_preview)),
            sandbox: ("allow-same-origin" if @agreement_retry_preview),
            class: "document-iframe", title: "Agreement document preview" do %>
        Your browser does not support iframes.
        <%= link_to "View Document", view_inline_document_path(@file.FileID), target: "_blank", class: "fallback-link" %>
      <% end %>
    </div>
  <% end %>

  <% if @conversation && @landlord && @tenant && @file.FileTypes == "html" && params[:view_mode] != 'simple' %>
    <% if @agreement_proposal.present? && @agreement_proposal.fetch("changes", {}).present? %>
      <% suggestions_pending = @file.agreement_suggestions_pending? %>
      <% mediator_proposal = @agreement_proposal["mediator_proposal"] == true %>
      <% can_decide = if mediator_proposal
                        suggestions_pending &&
                          @user_role_in_conversation.present? &&
                          @agreement_proposal.fetch("reviewer_ids", []).map(&:to_i).include?(@user.UserID)
                      else
                        suggestions_pending &&
                          @user_role_in_conversation.present? &&
                          @reviewer_id == @user.UserID
                      end %>
      <div class="signature-status-card agreement-suggestions-card">
        <div class="agreement-suggestions-heading">
          <div>
            <h2>Suggested Changes</h2>
            <p>Started by <%= @proposal_author ? "#{@proposal_author.Role} #{@proposal_author.FName} #{@proposal_author.LName}" : "a participant" %>. Review each offered value against the agreement above.<%= " Counteroffers will be shared after you address every item." if can_decide %></p>
          </div>
          <span class="suggestion-badge <%= suggestions_pending ? 'pending' : 'reviewed' %>"><%= suggestions_pending ? "Pending review" : "Reviewed" %></span>
        </div>
        <div class="suggestion-list">
          <% @file.agreement_suggestion_items.each do |item| %>
            <% field = item[:key] %>
            <% change = item[:change] %>
            <% mediator_proposal_item = @agreement_proposal["mediator_proposal"] == true %>
            <% review_role = if @user.UserID == @conversation&.TenantID
                              "tenant"
                            elsif @user.UserID == @conversation&.LandlordID
                              "landlord"
                            end %>

            <% can_decide_item = if mediator_proposal_item
                                  can_decide &&
                                    review_role.present? &&
                                    item[:fields].all? do |candidate|
                                      field_change = @agreement_proposal["changes"][candidate]
                                      field_change["decision"] == "pending" &&
                                        field_change.fetch("party_decisions", {})[review_role] == "pending"
                                    end
                                else
                                  can_decide
                                end %>
            <% label = if @file.custom_resolution?
                         custom_resolution_group_label(field)
                       elsif item[:payment_group]
                         "Payment #{field.delete_prefix('payment')}#{item[:removed_payment] ? ' removed' : (item[:added_payment] ? ' added' : '')}"
                       else
                         agreement_field_label(field)
                       end %>
            <% offerer = @offer_authors&.dig(item[:offered_by_id].to_i) %>
            <% staged = @agreement_proposal.fetch('draft_counteroffers', {})[field] if can_decide %>
            <% before_label = change['decision'] == 'accepted' ? 'Before acceptance' : 'In document' %>
            <% offered_label = { 'accepted' => 'Accepted in document', 'rejected' => 'Rejected suggestion' }.fetch(change['decision'], 'Suggested') %>
            <div class="suggestion-item" id="suggestion-<%= field %>">
              <div class="suggestion-item-heading">
                <strong><%= label %></strong>
                <span class="suggestion-badge <%= change['decision'] %>"><%= staged ? 'Counteroffer ready' : change['decision'].humanize %></span>
              </div>
              <p class="suggestion-offerer">Offered by <%= offerer ? "#{offerer.Role} #{offerer.FName} #{offerer.LName}" : "a participant" %></p>
              <div class="suggestion-values">
                <% if item[:payment_group] %>
                  <div><span><%= before_label %></span>
                    <strong>Amount: <%= agreement_field_value("amount#{field.delete_prefix('payment')}", change['from_amount']) %></strong>
                    <strong>Due date: <%= agreement_field_value("date#{field.delete_prefix('payment')}", change['from_date']) %></strong>
                  </div>
                  <div><span><%= offered_label %></span>
                    <% if item[:removed_payment] %>
                      <strong>Payment removed</strong>
                    <% else %>
                      <strong>Amount: <%= agreement_field_value("amount#{field.delete_prefix('payment')}", change['to_amount']) %></strong>
                      <strong>Due date: <%= agreement_field_value("date#{field.delete_prefix('payment')}", change['to_date']) %></strong>
                    <% end %>
                  </div>
                <% elsif item[:terms_group] %>
                  <% %w[from to].zip([before_label, offered_label]).each do |side, heading| %>
                    <div><span><%= heading %></span>
                      <% item[:fields].each do |term_field| %>
                        <% term_change = @agreement_proposal["changes"].fetch(term_field) %>
                        <% next if term_change["from"] == term_change["to"] %>
                        <strong><%= agreement_field_label(term_field) %>: <%= agreement_field_value(term_field, term_change[side]) %></strong>
                      <% end %>
                    </div>
                  <% end %>
                <% else %>
                  <div><span><%= before_label %></span><strong><%= agreement_field_value(field, change['from']) %></strong></div>
                  <div><span><%= offered_label %></span><strong><%= agreement_field_value(field, change['to']) %></strong></div>
                <% end %>
              </div>
              <% if staged %>
                <div class="suggestion-staged">
                  <strong>Your counteroffer is saved and will be sent when you finish this review:</strong>
                  <% item[:fields].each do |staged_field| %>
                    <span><%= agreement_field_label(staged_field) %>: <%= agreement_field_value(staged_field, staged[staged_field]) %></span>
                  <% end %>
                </div>
              <% end %>
              <% if mediator_proposal_item %>
                <% party_decisions = @agreement_proposal["changes"][item[:fields].first].fetch("party_decisions", {}) %>
                <% landlord_decision = party_decisions["landlord"] %>
                <% tenant_decision = party_decisions["tenant"] %>

                <% if change["decision"] == "accepted" %>
                  <p class="suggestion-review-note">
                    Accepted by both parties. This change has been applied to the agreement.
                  </p>
                <% elsif change["decision"] == "rejected" %>
                  <p class="suggestion-review-note">
                    Suggestion rejected. No changes were applied.
                  </p>
                <% elsif landlord_decision == "accepted" && tenant_decision == "pending" %>
                  <p class="suggestion-review-note">
                    Waiting for tenant to review.
                  </p>
                <% elsif tenant_decision == "accepted" && landlord_decision == "pending" %>
                  <p class="suggestion-review-note">
                    Waiting for landlord to review.
                  </p>
                <% elsif landlord_decision == "pending" && tenant_decision == "pending" %>
                  <p class="suggestion-review-note">
                    Waiting for landlord and tenant to review.
                  </p>
                <% end %>
              <% else %>
                <% if suggestions_pending && change['decision'] == 'pending' && item[:offered_by_id].to_i == @user.UserID %>
                  <p class="suggestion-review-note">
                    Waiting for the other party to review this offer.
                  </p>
                <% elsif suggestions_pending && (staged || change['decision'] != 'pending') %>
                  <p class="suggestion-review-note">
                    Decision recorded. This item is closed.
                  </p>
                <% end %>
              <% end %>
              <% if can_decide_item && !staged && item[:fields].all? { |candidate| @agreement_proposal["changes"][candidate]["decision"] == "pending" } && item[:offered_by_id].to_i != @user.UserID %>
                <div class="suggestion-actions">
                  <%= button_to "Accept", decide_document_suggestion_path(@file.FileID, field), method: :patch,
                      params: { decision: "accepted" }, aria: { label: "Accept #{label}" },
                      class: "suggestion-accept #{'selected' if change['decision'] == 'accepted'}" %>
                  <%= button_to "Reject", decide_document_suggestion_path(@file.FileID, field), method: :patch,
                      params: { decision: "rejected" }, aria: { label: "Reject #{label}" },
                      class: "suggestion-reject #{'selected' if change['decision'] == 'rejected'}" %>
                  <% if change['decision'] == 'pending' %>
                    <button type="button" class="suggestion-counteroffer-toggle" aria-expanded="<%= (params[:counteroffer_error] == field || @counteroffer_error_field == field) %>" aria-controls="counteroffer-<%= field %>">Counteroffer</button>
                  <% end %>
                </div>
                <% if change['decision'] == 'pending' %>
                  <div class="suggestion-counteroffer-panel" id="counteroffer-<%= field %>" <%= 'hidden' unless (params[:counteroffer_error] == field || @counteroffer_error_field == field) %>>
                  <%= form_with url: counteroffer_document_suggestion_path(@file.FileID, field), method: :patch,
                                local: true, class: "suggestion-counteroffer-form" do %>
                    <p>Type or select your counteroffer.</p>
                    <% if (params[:counteroffer_error] == field || @counteroffer_error_field == field) %>
                      <p class="suggestion-save-error" role="alert"><%= @agreement_editor_error || (params[:counteroffer_reason] == 'payment' ? (@file.AgreementTemplate == 'b' ? 'Complete the details required by your selections.' : 'A payment date needs a payment amount.') : 'Enter a different value for this counteroffer.') %></p>
                    <% end %>
                    <% case_status = if @file.revised_move_out? && item[:fields].include?("case_status")
                         if @counteroffer_error_field == field
                           @submitted_counteroffer["case_status"]
                         elsif staged
                           staged["case_status"]
                         else
                           @agreement_proposal.dig("changes", "case_status", "to")
                         end
                       end %>
                    <% if @file.custom_resolution? %>
                      <% changes = @agreement_proposal.fetch("changes")
                         values = if @counteroffer_error_field == field
                           @submitted_counteroffer
                         else
                           staged || item[:fields].index_with { |key| changes.dig(key, "to") }
                         end %>
                      <div class="suggestion-counteroffer-fields" data-custom-resolution-fields>
                        <%= render "documents/custom_resolution_fields", fields: item[:fields].index_with { |key| CustomResolutionTerms.definition(key) },
                              values: values, prefix: "counteroffer", id_prefix: "counteroffer" %>
                      </div>
                    <% else %>
                    <div class="suggestion-counteroffer-fields">
                      <% item[:fields].each do |counter_field| %>
                        <% offered_value = if @counteroffer_error_field == field
                             @submitted_counteroffer[counter_field]
                           elsif staged
                             staged[counter_field]
                           else
                             @agreement_proposal["changes"][counter_field]["to"]
                           end %>
                        <% filed_case_detail = @file.revised_move_out? && MoveOutTerms::FILED_CASE_FIELDS.include?(counter_field) %>
                        <div class="form-group" <%= 'data-counteroffer-filed-case' if filed_case_detail %>
                             <%= 'hidden' if filed_case_detail && case_status != "filed" %>>
                          <%= label_tag "counteroffer_#{counter_field}", "Your proposed #{agreement_field_label(counter_field).downcase}", class: "form-label" %>
                          <% if @file.revised_move_out? && (choices = MoveOutTerms::CHOICES[counter_field]) %>
                            <%= select_tag "counteroffer[#{counter_field}]", options_for_select(choices.map { |choice| [choice.humanize, choice] }, offered_value),
                                  include_blank: true, id: "counteroffer_#{counter_field}", class: "form-input" %>
                          <% elsif @file.revised_move_out? && MoveOutTerms::METHOD_FIELDS.include?(counter_field) %>
                            <%= select_tag "counteroffer[#{counter_field}]", options_for_select([["Not selected", ""], ["Selected", "yes"]], offered_value),
                                  id: "counteroffer_#{counter_field}", class: "form-input" %>
                          <% elsif @file.revised_pay_and_stay? && (choices = pay_and_stay_counteroffer_choices(counter_field)) %>
                            <%= select_tag "counteroffer[#{counter_field}]", options_for_select(choices, offered_value),
                                  include_blank: true, id: "counteroffer_#{counter_field}", class: "form-input" %>
                          <% elsif (@file.AgreementTemplate == "b" && PayAndStayTerms::COUNTS.include?(counter_field)) ||
                                (@file.revised_move_out? && MoveOutTerms::COUNTS.include?(counter_field)) %>
                            <%= number_field_tag "counteroffer[#{counter_field}]", offered_value, id: "counteroffer_#{counter_field}", min: 1, step: 1, class: "form-input" %>
                          <% elsif counter_field.match?(/\Adate[1-6]\z/) || %w[negotiation_date vacate_date lump_sum_date monthly_payment_start final_payment_date forgiveness_deadline].include?(counter_field) ||
                                (@file.AgreementTemplate == "b" && PayAndStayTerms::DATES.include?(counter_field)) ||
                                (@file.revised_move_out? && MoveOutTerms::DATES.include?(counter_field)) %>
                            <%= date_field_tag "counteroffer[#{counter_field}]", offered_value, id: "counteroffer_#{counter_field}", class: "form-input" %>
                          <% elsif counter_field.match?(/\Aamount[1-6]\z/) || %w[money_owed monthly_rent rent_owed late_fees utilities other_charges lump_sum_amount monthly_payment_amount final_payment_amount credits_amount reductions_amount forgiveness_amount forgiveness_remaining_amount].include?(counter_field) ||
                                (@file.AgreementTemplate == "b" && PayAndStayTerms::AMOUNTS.include?(counter_field)) ||
                                (@file.revised_move_out? && counter_field == "move_out_amount") %>
                            <%= number_field_tag "counteroffer[#{counter_field}]", offered_value, id: "counteroffer_#{counter_field}", step: 0.01, min: 0, class: "form-input" %>
                          <% elsif PayAndStayTerms::PAYMENT_OPTIONS.key?(counter_field) %>
                            <%= select_tag "counteroffer[#{counter_field}]", options_for_select([["Selected", "1"], ["Not selected", "0"]], offered_value), include_blank: true, id: "counteroffer_#{counter_field}", class: "form-input" %>
                          <% elsif counter_field == "payment_method" %>
                            <% if @file.revised_pay_and_stay? %>
                              <%= hidden_field_tag "counteroffer[payment_method][]", "", id: nil %>
                              <%= select_tag "counteroffer[payment_method][]",
                                    options_for_select(PayAndStayTerms::PAYMENT_METHODS.invert.to_a, PayAndStayTerms.payment_methods(offered_value)),
                                    multiple: true, id: "counteroffer_payment_method", class: "form-input" %>
                            <% else %>
                              <%= select_tag "counteroffer[#{counter_field}]", options_for_select(PayAndStayTerms::PAYMENT_METHODS.invert.to_a, offered_value), id: "counteroffer_#{counter_field}", class: "form-input" %>
                            <% end %>
                          <% elsif counter_field.match?(/\Atime[1-6]\z/) || (@file.revised_move_out? && counter_field == "move_out_time") %>
                            <%= time_field_tag "counteroffer[#{counter_field}]", offered_value, id: "counteroffer_#{counter_field}", class: "form-input" %>
                          <% elsif counter_field == "additional_terms" ||
                                (@file.AgreementTemplate == "b" && PayAndStayTerms::MULTILINE.include?(counter_field)) ||
                                (@file.revised_move_out? && counter_field == "move_out_schedule") %>
                            <%= text_area_tag "counteroffer[#{counter_field}]", offered_value, id: "counteroffer_#{counter_field}", class: "form-input", rows: 3 %>
                          <% else %>
                            <%= text_field_tag "counteroffer[#{counter_field}]", offered_value, id: "counteroffer_#{counter_field}", class: "form-input" %>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                    <% end %>
                    <%= submit_tag "Save Counteroffer", class: "agreement-action" %>
                  <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @file.agreement_editable? && !@file.agreement_suggestions_pending? && @can_suggest_agreement && !@editing_agreement %>
      <div class="signature-status-card agreement-suggestion-entry-card">
        <h2>Suggest Changes</h2>
        <p>
          <% if @user.mediator? %>
            Your suggested changes will be sent to both the landlord and tenant for review.
          <% else %>
            Your suggested changes will be sent to the other party for review before signing.
          <% end %>
        </p>
        <div class="form-actions">
          <%= link_to "Suggest Changes", review_document_path(@file.FileID), class: "agreement-action" %>
        </div>
      </div>
    <% end %>

    <% needs_signature = @user_role_in_conversation.present? && !@file.public_send("#{@user_role_in_conversation.capitalize}Signature") %>
    <% if @file.agreement_suggestions_pending? && needs_signature %>
      <div class="signing-card">
        <h2><i class="fa-solid fa-pen-to-square"></i> Signing Paused</h2>
        <p class="signing-description">The pending suggested changes must be reviewed before signing can resume.</p>
      </div>
    <% elsif needs_signature && @file.agreement_to_mediate? && !@editing_agreement && (error = @file.mediator_signing_error(@conversation)) %>
      <p role="status"><%= error %></p>
    <% elsif @file.agreement_signable? && needs_signature && !@editing_agreement %>
      <% signer = @user %>
      <div class="signing-card" data-signer-role="<%= @user_role_in_conversation %>">
        <h2><i class="fa-solid fa-pen-to-square"></i> Sign This Document</h2>
        <p class="signing-description">Sign only if you agree to the version shown above. If suggested changes are later accepted, all required signers will need to sign the updated document.</p>
        <%= form_with url: apply_signature_document_path(@file.FileID), method: :post, local: true, class: "signature-form" do |form| %>
          <%= hidden_field_tag :agreement_version, @file.AgreementVersion if @file.agreement_document? %>
          <% if @file.revised_move_out? || @file.custom_resolution? || @file.agreement_to_mediate? %>
            <p>Your signature will be recorded as <strong>/s/ <%= [signer.FName, signer.LName].compact.join(" ").squish %></strong>.</p>
          <% else %>
            <div class="form-group">
              <%= form.label :signature_name, "Your Full Name", class: "form-label" %>
              <%= form.text_field :signature_name, value: "#{signer.FName} #{signer.LName}", class: "form-input", required: true %>
              <small class="form-hint">Your signature will be recorded as: <strong>/s/ [Your Name]</strong></small>
            </div>
          <% end %>
          <div class="form-actions">
            <%= form.submit "Sign Document", class: "btn-sign", disabled: true, id: "sign-document-button" %>
          </div>
          <p id="sign-scroll-hint" class="form-hint" role="status">Scroll to the bottom of the document above to enable signing.</p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  (function() {
    const card = document.querySelector('.agreement-suggestions-card');
    const positionKey = 'agreement-suggestion-position-<%= @file.FileID %>';

    function restorePosition() {
      const saved = sessionStorage.getItem(positionKey);
      if (!saved) return;
      const position = JSON.parse(saved);
      const item = document.getElementById(position.id) || card;
      if (!item) return;
      const difference = item.getBoundingClientRect().top - position.top;
      document.body.scrollTop += difference;
      window.scrollTo(0, window.scrollY + difference);
    }

    if (sessionStorage.getItem(positionKey)) {
      history.scrollRestoration = 'manual';
      restorePosition();
      const finishRestore = function() {
        requestAnimationFrame(function() {
          restorePosition();
          sessionStorage.removeItem(positionKey);
          history.scrollRestoration = 'auto';
        });
      };
      if (document.readyState === 'complete') finishRestore();
      else window.addEventListener('load', finishRestore, { once: true });
    }

    if (!card) return;
    card.addEventListener('change', function(event) {
      if (!event.target.matches('[name="counteroffer[case_status]"]')) return;
      event.target.form.querySelectorAll('[data-counteroffer-filed-case]').forEach(function(field) {
        field.hidden = event.target.value !== 'filed';
      });
    });
    card.addEventListener('click', function(event) {
      const toggle = event.target.closest('.suggestion-counteroffer-toggle');
      if (!toggle) return;
      const panel = document.getElementById(toggle.getAttribute('aria-controls'));
      panel.hidden = !panel.hidden;
      toggle.setAttribute('aria-expanded', String(!panel.hidden));
      if (!panel.hidden) panel.querySelector('input, select, textarea')?.focus();
    });
    card.addEventListener('submit', async function(event) {
      const form = event.target.closest('.suggestion-actions form, .suggestion-counteroffer-form');
      if (!form) return;
      event.preventDefault();

      const item = form.closest('.suggestion-item');
      const buttons = card.querySelectorAll('.suggestion-item button, .suggestion-item input[type="submit"]');
      if (card.dataset.saving === 'true') return;
      card.dataset.saving = 'true';
      buttons.forEach(function(button) { button.disabled = true; });
      let refreshing = false;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' }
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'The decision could not be saved. Refresh the agreement and try again.');
        if (result.status === 'pending') {
          const badge = item.querySelector('.suggestion-item-heading .suggestion-badge');
          badge.className = 'suggestion-badge ' + result.decision;
          badge.textContent = result.decision === 'accepted' ? 'Accepted' : 'Rejected';
          item.querySelector('.suggestion-actions')?.remove();
          item.querySelector('.suggestion-counteroffer-panel')?.remove();
          item.querySelector('.suggestion-staged')?.remove();
          const note = document.createElement('p');
          note.className = 'suggestion-review-note';
          note.textContent = 'Decision recorded. This item is closed.';
          item.append(note);
        } else if (result.status === 'countered' && !result.round_complete) {
          const refreshed = await fetch(location.pathname + location.search, {
            credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'text/html' }
          });
          if (!refreshed.ok) throw new Error('Counteroffer sent. Reload the agreement to see it.');
          const page = new DOMParser().parseFromString(await refreshed.text(), 'text/html');
          const updatedItem = page.getElementById(item.id);
          if (!updatedItem) throw new Error('Counteroffer sent. Reload the agreement to see it.');
          const pageScroll = window.scrollY;
          const bodyScroll = document.body.scrollTop;
          item.replaceWith(updatedItem);
          document.body.scrollTop = bodyScroll;
          window.scrollTo(0, pageScroll);
          requestAnimationFrame(function() {
            document.body.scrollTop = bodyScroll;
            window.scrollTo(0, pageScroll);
          });
        } else if (['updated', 'rejected'].includes(result.status) || (result.status === 'countered' && result.round_complete)) {
          sessionStorage.setItem(positionKey, JSON.stringify({ id: item.id, top: item.getBoundingClientRect().top }));
          history.scrollRestoration = 'manual';
          history.replaceState(null, '', location.pathname + location.search);
          refreshing = true;
          window.location.reload();
          return;
        } else {
          throw new Error('The decision could not be saved. Refresh the agreement and try again.');
        }
        item.querySelector('.suggestion-save-error')?.remove();
      } catch (error) {
        let message = item.querySelector('.suggestion-save-error');
        if (!message) {
          message = document.createElement('p');
          message.className = 'suggestion-save-error';
          message.setAttribute('role', 'alert');
          const panel = item.querySelector('.suggestion-counteroffer-panel');
          if (panel && form.matches('.suggestion-counteroffer-form')) {
            panel.hidden = false;
            item.querySelector('.suggestion-counteroffer-toggle')?.setAttribute('aria-expanded', 'true');
            panel.querySelector('p')?.after(message);
          } else {
            item.append(message);
          }
        }
        message.textContent = error.message;
      } finally {
        if (!refreshing) {
          card.dataset.saving = 'false';
          buttons.forEach(function(button) { button.disabled = false; });
        }
      }
    });
  })();
</script>

<script>
  (function() {
    const preview = document.querySelector('.document-iframe');
    const signButton = document.getElementById('sign-document-button');
    const hint = document.getElementById('sign-scroll-hint');
    if (!preview || !signButton) return;

    function checkDocumentScroll(fromScroll) {
      try {
        const frameWindow = preview.contentWindow;
        if (frameWindow.location.href !== preview.src) return;
        const page = frameWindow.document.scrollingElement || frameWindow.document.documentElement;
        const fitsInPreview = page.scrollHeight <= page.clientHeight + 2;
        if (fitsInPreview || (fromScroll && page.scrollTop + page.clientHeight >= page.scrollHeight - 2)) {
          signButton.disabled = false;
          hint.hidden = true;
        }
      } catch (error) {
        hint.hidden = false;
        hint.textContent = 'The document preview could not be checked. Reload this page to review it before signing.';
      }
    }

    function onDocumentScroll() { checkDocumentScroll(true); }

    preview.addEventListener('load', function() {
      signButton.disabled = true;
      hint.hidden = false;
      hint.textContent = 'Scroll to the bottom of the document above to enable signing.';
      preview.contentWindow.addEventListener('scroll', onDocumentScroll, { passive: true });
      checkDocumentScroll(false);
    });
    if (preview.contentDocument && preview.contentDocument.readyState === 'complete' &&
        preview.contentWindow.location.href === preview.src) {
      preview.contentWindow.addEventListener('scroll', onDocumentScroll, { passive: true });
      checkDocumentScroll(false);
    }
  })();
</script>

<% if @conversation %>
<script>
  (function() {
    // Check if ActionCable is available
    if (typeof ActionCable === 'undefined') {
      console.warn('ActionCable not loaded, signature updates will not be real-time');
      return;
    }
    
    const fileId = <%= raw(json_escape(@file.FileID.to_json)) %>;
    const currentUserId = <%= raw(json_escape(@user.UserID.to_json)) %>;
    const cable = ActionCable.createConsumer();
    
    const subscription = cable.subscriptions.create(
      { channel: "DocumentSignatureChannel", file_id: fileId },
      {
        received(data) {
          if (data.type === 'agreement_proposal_update') {
            if (String(data.actor_id) === String(currentUserId)) return;
            window.location.reload();
            return;
          }
          if (data.type === 'signature_update') {
            document.querySelectorAll('.signature-party[data-signature-role]').forEach(party => {
              const role = party.dataset.signatureRole;
              if (!data[role + '_signature']) return;

              const status = party.querySelector('.signature-status');
              status.className = 'signature-status signed';
              status.innerHTML = '<i class="fa-solid fa-check-circle"></i> Signed';
              const signedAt = data[role + '_signed_at'];
              if (signedAt && !party.querySelector('.signature-timestamp')) {
                const timestamp = document.createElement('div');
                timestamp.className = 'signature-timestamp';
                timestamp.textContent = signedAt;
                party.appendChild(timestamp);
              }
            });

            const signingCard = document.querySelector('.signing-card[data-signer-role]');
            if (signingCard && data[signingCard.dataset.signerRole + '_signature']) signingCard.remove();
            const documentPreview = document.querySelector('.document-iframe');
            if (documentPreview) documentPreview.src = documentPreview.src;
            
            // Show the completion banner when all required signatures are present.
            if (data.both_signed) {
              document.querySelector('.agreement-suggestion-entry-card')?.remove();
              const statusCard = document.getElementById('signature-status-card');
              if (statusCard && !statusCard.querySelector('.completion-banner')) {
                const banner = document.createElement('div');
                banner.className = 'completion-banner';
                banner.innerHTML = '<i class="fa-solid fa-check-circle"></i><strong>Document Fully Executed</strong> - All required signers have signed this agreement.';
                statusCard.appendChild(banner);
              }
            }
          }
        }
      }
    );
  })();
</script>
<% end %>
