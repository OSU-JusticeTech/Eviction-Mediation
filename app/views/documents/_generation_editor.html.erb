<% review_file = local_assigns[:review_file]
   template = review_file ? review_file.AgreementTemplate : @template
   values = review_file ? (@submitted_agreement_terms || review_file.agreement_terms) : @generation_values
   custom = template == CustomResolutionTerms::TEMPLATE
   preview = if custom
     render(template: "documents/templates/custom_resolution_v1", layout: false, locals: { inline_editor: true, editor_values: values })
   else
     @agreement_retry_preview
   end %>
<div class="docs-wrapper"
     data-document-generation-editor
     data-agreement-template="<%= template %>"
     <% if custom %>data-custom-signer-error="<%= CustomResolutionTerms::SIGNER_ERROR %>"<% end %>
     <% if template == MoveOutTerms::TEMPLATE %>data-required-agreement-fields="<%= MoveOutTerms::REQUIRED.join(" ") %>"
       data-move-out-rules="<%= MoveOutTerms.editor_rules.to_json %>"<% end %>>

  <h1 class="docs-title"><%= review_file ? "Suggest Changes" : "Create #{@template_name}" %></h1>
  <p class="docs-subtitle">
    Click the highlighted fields in the agreement to enter information.
    The legal terms cannot be edited.
  </p>

  <% if custom %><noscript>JavaScript is required to complete the agreement in the preview.</noscript><% end %>
  <p data-agreement-edit-count role="status">No information entered yet</p>
  <p data-agreement-editor-error role="alert" <%= "hidden" unless @agreement_editor_error %>><%= @agreement_editor_error %></p>

  <%= form_with url: (review_file ? update_review_document_path(review_file.FileID) : generate_from_intake_path(template: template)),
                method: (review_file ? :patch : :post),
                local: true,
                data: { turbo: false },
                html: { id: "document-generation-form" } do %>

    <% if review_file %>
      <%= hidden_field_tag :agreement_version, review_file.AgreementVersion %>
      <%= hidden_field_tag :custom_full_form, "1" %>
    <% else %>
      <%= hidden_field_tag :conversation_id, params[:conversation_id] if params[:conversation_id].present? %>
      <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
    <% end %>

    <% fields = custom ? CustomResolutionTerms.groups(values.keys).values.flatten : @generation_fields %>

    <% fields.each do |field| %>
      <% next if field == "reason" && template != MoveOutTerms::TEMPLATE %>

      <%= hidden_field_tag field,
                          values.fetch(field, ""),
                          data: { agreement_term: field } %>
    <% end %>


    <% if template == "b" %>
      <div class="form-group" style="margin: 20px 0;">
        <%= label_tag :reason, "Payment Issue (include payments and months or dates covered)",
                      class: "form-label required-label" %>

        <%= text_area_tag :reason,
                          values.fetch("reason", ""),
                          class: "form-control",
                          rows: 3,
                          required: true,
                          placeholder: "Example: Unpaid rent for September and October 2026",
                          data: { agreement_term: "reason" } %>
      </div>
    <% elsif !custom && template != MoveOutTerms::TEMPLATE %>
      <div class="form-group" style="margin: 20px 0;">
        <%= label_tag :reason, "Reason for Dispute", class: "form-label required-label" %>

        <%= select_tag :reason,
            options_for_select([
              ["Select a reason", ""],
              "Failure to Pay Rent",
              "Violation of Lease Terms",
              "Damage to Property",
              "Illegal Activity",
              "Nuisance or Disturbance",
              "Expiration of Lease",
              "Unknown"
            ], values.fetch("reason", "")),
            class: "form-select",
            required: true,
            data: { agreement_term: "reason" } %>
      </div>
    <% end %>

    <div class="form-actions">
      <% if review_file %>
        <%= link_to "Cancel", view_file_path(review_file.FileID), class: "btn btn-secondary" %>
      <% else %>
        <%= link_to "Back to Templates", generate_file_path(conversation_id: params[:conversation_id], return_to: params[:return_to]), class: "btn btn-secondary" %>
      <% end %>
      <%= submit_tag(review_file ? "Send Suggested Changes" : "Generate Document",
                    class: "btn btn-primary",
                    disabled: custom, data: { generation_finish: true }) %>
    </div>

    <% end %>

  <div class="document-preview-card">
    <%= tag.iframe src: (template_preview_path(template: template) unless review_file),
          srcdoc: (preview && String.new(preview)),
          sandbox: ("allow-same-origin" if preview),
          class: "document-iframe", title: "Editable agreement preview",
          style: "width: 100%; height: 850px; border: 1px solid #ddd;" %>
  </div>
</div>