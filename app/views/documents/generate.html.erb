<div class="docs-wrapper">
  <h1 class="docs-title">Select a Template</h1>
  <p class="docs-subtitle">Choose a template for generating your proposal document</p>

  <div class="template-grid">
    <div class="template-card">
      <div class="template-header">
        <h3 class="template-title">Move-Out Agreement</h3>
        <span class="template-badge">Template A</span>
      </div>
      <div class="template-preview">
        <iframe src="<%= template_preview_path(template: MoveOutTerms::TEMPLATE) %>" width="100%" height="400" frameborder="0">
          Your browser does not support embedded previews.
        </iframe>
      </div>
      <div class="template-footer">
        <%= link_to 'Select Template A', template_intake_path(template: MoveOutTerms::TEMPLATE, conversation_id: params[:conversation_id], return_to: params[:return_to]), class: 'btn btn-primary btn-block' %>
      </div>
    </div>

    <div class="template-card">
      <div class="template-header">
        <h3 class="template-title">Pay and Stay Agreement</h3>
        <span class="template-badge">Template B</span>
      </div>
      <div class="template-preview">
        <iframe src="<%= template_preview_path(template: 'b') %>" width="100%" height="400" frameborder="0">
          Your browser does not support embedded previews.
        </iframe>
      </div>
      <div class="template-footer">
        <%= link_to 'Select Template B', template_intake_path(template: 'b', conversation_id: params[:conversation_id], return_to: params[:return_to]), class: 'btn btn-primary btn-block' %>
      </div>
    </div>

    <% if @show_mediation_template %>
      <div class="template-card">
        <div class="template-header">
          <h3 class="template-title">Agreement to Mediate</h3>
          <span class="template-badge">Template C</span>
        </div>
        <div class="template-preview">
          <iframe src="<%= template_preview_path(template: AgreementToMediateTerms::TEMPLATE, conversation_id: params[:conversation_id]) %>" width="100%" height="400" frameborder="0">
            Your browser does not support embedded previews.
          </iframe>
        </div>
        <div class="template-footer">
          <%= link_to 'Select Template C', template_intake_path(template: AgreementToMediateTerms::TEMPLATE, conversation_id: params[:conversation_id], return_to: params[:return_to]), class: 'btn btn-primary btn-block' %>
        </div>
      </div>
    <% end %>
    <div class="template-card">
      <div class="template-header">
        <h3 class="template-title">Custom Resolution Agreement</h3>
        <span class="template-badge">Template D</span>
      </div>
      <div class="template-preview">
        <iframe src="<%= template_preview_path(template: CustomResolutionTerms::TEMPLATE) %>" width="100%" height="400" frameborder="0" title="Custom Resolution Agreement preview"></iframe>
      </div>
      <div class="template-footer">
        <%= link_to "Select Template D", template_intake_path(template: CustomResolutionTerms::TEMPLATE,
              conversation_id: params[:conversation_id], return_to: params[:return_to]), class: "btn btn-primary btn-block" %>
      </div>
    </div>
  </div>
</div>
