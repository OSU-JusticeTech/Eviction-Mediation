<!-- Admin Actions -->
<div class="action-cards-grid">
  <%= render "action_card", path: admin_mediations_path, icon: "fa-gavel",
        title: "Mediations", description: "Monitor flagged cases and ongoing mediations",
        label: "Manage Mediations" %>

  <%= render "action_card", path: admin_accounts_path, icon: "fa-users-cog",
        title: "Account Management", description: "Update mediator accounts and user settings",
        label: "Manage Accounts" %>
</div>

<!-- System Overview -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon stat-icon--active">
      <i class="fas fa-gavel"></i>
    </div>
    <div class="stat-content">
      <h3><%= PrimaryMessageGroup.where(accepted_by_landlord: true, accepted_by_tenant: true, deleted_at: nil).where.not(IntakeID: nil).count %></h3>
      <p>Active Mediations</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon stat-icon--unassigned">
      <i class="fas fa-user-clock"></i>
    </div>
    <div class="stat-content">
      <h3><%= PrimaryMessageGroup.where(MediatorRequested: true, MediatorAssigned: false, deleted_at: nil).count %></h3>
      <p>Unassigned Requests</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon stat-icon--ended">
      <i class="fas fa-flag-checkered"></i>
    </div>
    <div class="stat-content">
      <h3><%= PrimaryMessageGroup.where("deleted_at >= ?", 7.days.ago).count %></h3>
      <p>Ended This Week</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon stat-icon--feedback">
      <i class="fas fa-comment-dots"></i>
    </div>
    <div class="stat-content">
      <h3><%= PrimaryMessageGroup.where.not(deleted_at: nil).where(EndOfConversationGoodFaithLandlord: nil).or(PrimaryMessageGroup.where.not(deleted_at: nil).where(EndOfConversationGoodFaithTenant: nil)).count %></h3>
      <p>Awaiting Feedback</p>
    </div>
  </div>
</div>

<!-- Mediator Availability -->
<div class="info-section">
  <div class="info-header">
    <h2><i class="fas fa-user-check"></i> Mediator Availability</h2>
    <p>Current status of all mediators in the system</p>
  </div>

  <div class="mediator-grid">
    <% User.includes(:mediator).where(Role: "Mediator").each do |mediator| %>
      <% available = mediator.mediator&.Available %>
      <%= link_to admin_account_path(mediator), class: "mediator-card" do %>
        <div class="mediator-info">
          <div class="mediator-avatar">
            <%= mediator.FName.first.upcase %><%= mediator.LName.first.upcase %>
          </div>
          <div class="mediator-details">
            <h4><%= "#{mediator.FName} #{mediator.LName}" %></h4>
            <p><%= mediator.Email %></p>
          </div>
        </div>
        <div class="mediator-status">
          <span style="font-size: 0.8rem; color: #64748b;">
            <%= mediator.mediator&.ActiveMediations || 0 %>/<%= mediator.mediator&.MediationCap || 0 %> cases
          </span>
          <span class="status-badge <%= available ? 'available' : 'unavailable' %>">
            <i class="fas <%= available ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
            <%= available ? "Available" : "Busy" %>
          </span>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
