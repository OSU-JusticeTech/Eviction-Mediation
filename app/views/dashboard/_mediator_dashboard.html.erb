<% if @user.Role == "Mediator" && @user.mediator.present? %>
  <% available = @user.mediator.Available %>
  <% active_cases = @user.mediator.ActiveMediations || 0 %>
  <% capacity = @user.mediator.MediationCap || 0 %>

  <div class="mediator-top-row">
    <!-- Combined Status + Workload card (2/3) -->
    <div class="mediator-status-card">
      <%= render "availability_status_card", user: @user %>

      <div class="workload-card">
        <div class="workload-header">
          <h3><i class="fas fa-tasks"></i> Current Workload</h3>
        </div>
        <div class="workload-stats">
          <div class="workload-stat">
            <div class="stat-number"><%= active_cases %></div>
            <div class="stat-label">Active Cases</div>
          </div>
          <div class="workload-divider">/</div>
          <div class="workload-stat">
            <div class="stat-number"><%= capacity %></div>
            <div class="stat-label">Capacity</div>
          </div>
        </div>
        <div class="workload-bar">
          <div class="workload-progress" style="width: <%= capacity > 0 ? (active_cases.to_f / capacity * 100).round(1) : 0 %>%"></div>
        </div>
      </div>
    </div>

    <!-- Settings card (1/3) -->
    <div class="mediator-settings-panel">
      <%= render "action_card", path: account_path, icon: "fa-user-edit",
            title: "Account Settings", description: "Update your profile, availability, and preferences",
            label: "Manage Account" %>
    </div>
  </div>

  <!-- Mediator Schedule -->
  <div class="account-card" style="margin-top: 24px; margin-bottom: 24px;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
      <h2>
        <i class="fa-solid fa-calendar-days"></i>
        My Schedule
      </h2>

      <%= link_to edit_mediator_schedule_path,
                  class: "btn-primary",
                  style: "text-decoration: none;" do %>
        <i class="fa-solid fa-pen-to-square"></i>
        Edit Schedule
      <% end %>
    </div>

    <div class="card-body">
      <div id="mediator-calendar">
        <p style="color: #64748b;">
          <div id="mediator-calendar">
            <div class="calendar-toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <h3 id="calendar-month" style="margin: 0;"></h3>

              <div style="display: flex; gap: 8px;">
                <button type="button" id="calendar-prev" class="btn-secondary">
                  <i class="fa-solid fa-chevron-left"></i>
                </button>

                <button type="button" id="calendar-today" class="btn-secondary">
                  Today
                </button>

                <button type="button" id="calendar-next" class="btn-secondary">
                  <i class="fa-solid fa-chevron-right"></i>
                </button>
              </div>
            </div>

            <div id="calendar-grid" class="mediator-calendar-grid"></div>
            <p id="calendar-error" role="alert" style="color: #b91c1c;"></p>
          </div>
        </p>
      </div>
    </div>
  </div>

<% end %>

<%= render "active_cases" %>

<!-- Mediation Tips -->
<div class="info-section">
  <div class="info-header">
    <h2><i class="fas fa-lightbulb"></i> Effective Mediation Tips</h2>
    <p>Best practices for successful landlord-tenant mediation sessions</p>
  </div>

  <div class="tips-grid">
    <div class="tip-card">
      <div class="tip-icon">
        <i class="fas fa-ear-listen"></i>
      </div>
      <h4>Active Listening</h4>
      <p>Listen carefully to both parties' concerns and acknowledge their perspectives before proposing solutions.</p>
    </div>

    <div class="tip-card">
      <div class="tip-icon">
        <i class="fas fa-balance-scale"></i>
      </div>
      <h4>Stay Neutral</h4>
      <p>Maintain impartiality and avoid taking sides. Focus on facilitating communication rather than imposing solutions.</p>
    </div>

    <div class="tip-card">
      <div class="tip-icon">
        <i class="fas fa-handshake"></i>
      </div>
      <h4>Find Common Ground</h4>
      <p>Identify shared interests and goals to build momentum toward mutually acceptable agreements.</p>
    </div>

    <div class="tip-card">
      <div class="tip-icon">
        <i class="fas fa-file-signature"></i>
      </div>
      <h4>Document Agreements</h4>
      <p>Ensure all agreements are clearly documented and understood by both parties before concluding.</p>
    </div>
  </div>
</div>

<style>
  .mediator-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }

  .calendar-weekday {
    text-align: center;
    font-weight: 600;
    padding: 12px 4px;
    color: #475569;
  }

  .calendar-day {
    min-height: 100px;
    padding: 8px;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background: #fff;
    overflow-wrap: anywhere;
  }

  .calendar-day.today {
    border: 2px solid #3b82f6;
  }

  .calendar-day.other-month {
    background: #f8fafc;
    color: #94a3b8;
  }

  .calendar-event {
    margin-top: 5px;
    padding: 5px;
    border-radius: 4px;
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .calendar-event.meeting {
    background: #dbeafe;
    color: #1e40af;
  }

  .calendar-event.blocked {
    background: #fee2e2;
    color: #991b1b;
  }

  @media (max-width: 600px) {
    .calendar-day {
      min-height: 65px;
      padding: 3px;
      font-size: 0.75rem;
    }

    .calendar-event {
      font-size: 0.65rem;
      padding: 3px;
    }
  }
</style>

<script>
(() => {
  function initializeMediatorCalendar() {
    const grid = document.getElementById("calendar-grid");
    if (!grid) return;

    // Prevent duplicate listeners if Turbo revisits the page.
    if (grid.dataset.initialized === "true") return;
    grid.dataset.initialized = "true";

    const monthLabel = document.getElementById("calendar-month");
    const errorLabel = document.getElementById("calendar-error");
    const currentMonth = new Date();
    currentMonth.setDate(1);

    let meetings = [];
    let blocks = [];

    const dateKey = (date) =>
      `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;

    const sameDay = (a, b) => dateKey(a) === dateKey(b);

    const timeLabel = (date) =>
      date.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });

    function addEvent(dayCell, text, type, meetingId = null) {
      const event = document.createElement(
        meetingId !== null ? "a" : "div"
      );

      event.className = `calendar-event ${type}`;
      event.textContent = text;

      if (meetingId !== null) {
        event.href = `/mediator_scheduled_meetings/${encodeURIComponent(meetingId)}`;
        event.title = "View meeting details";
        event.style.display = "block";
        event.style.textDecoration = "none";
        event.style.cursor = "pointer";
      }

      dayCell.appendChild(event);
    }

    function renderCalendar() {
      grid.replaceChildren();

      const year = currentMonth.getFullYear();
      const month = currentMonth.getMonth();

      monthLabel.textContent = currentMonth.toLocaleDateString([], {
        month: "long",
        year: "numeric"
      });

      ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].forEach(day => {
        const header = document.createElement("div");
        header.className = "calendar-weekday";
        header.textContent = day;
        grid.appendChild(header);
      });

      const firstWeekday = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const totalCells = Math.ceil((firstWeekday + daysInMonth) / 7) * 7;

      for (let i = 0; i < totalCells; i++) {
        const date = new Date(year, month, i - firstWeekday + 1);
        const cell = document.createElement("div");
        cell.className = "calendar-day";

        if (date.getMonth() !== month) cell.classList.add("other-month");
        if (sameDay(date, new Date())) cell.classList.add("today");

        const number = document.createElement("strong");
        number.textContent = date.getDate();
        cell.appendChild(number);

        meetings.forEach(meeting => {
          if ((meeting.Status || "").toLowerCase() === "canceled") return;

          const start = new Date(meeting.StartTime);
          if (Number.isNaN(start.getTime()) || !sameDay(start, date)) return;

          addEvent(
            cell,
            `${timeLabel(start)} · Case #${meeting.ConversationID}`,
            "meeting",
            meeting.id
          );
        });

        blocks.forEach(block => {
          const start = new Date(block.StartTime);
          const end = new Date(block.EndTime);

          if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return;

          // Display a blocked period on every day it overlaps.
          const dayStart = new Date(date.getFullYear(), date.getMonth(), date.getDate());
          const dayEnd = new Date(date.getFullYear(), date.getMonth(), date.getDate() + 1);

          if (start < dayEnd && end > dayStart) {
            addEvent(cell, "Blocked", "blocked");
          }
        });

        grid.appendChild(cell);
      }
    }

    document.getElementById("calendar-prev")?.addEventListener("click", () => {
      currentMonth.setMonth(currentMonth.getMonth() - 1);
      renderCalendar();
    });

    document.getElementById("calendar-next")?.addEventListener("click", () => {
      currentMonth.setMonth(currentMonth.getMonth() + 1);
      renderCalendar();
    });

    document.getElementById("calendar-today")?.addEventListener("click", () => {
      currentMonth.setFullYear(new Date().getFullYear(), new Date().getMonth(), 1);
      renderCalendar();
    });

    async function loadCalendarData() {
      try {
        const [meetingResponse, blockResponse] = await Promise.all([
          fetch("/mediator_scheduled_meetings", { headers: { Accept: "application/json" } }),
          fetch("/mediator_schedule_blocks", { headers: { Accept: "application/json" } })
        ]);

        if (!meetingResponse.ok || !blockResponse.ok) {
          throw new Error("Unable to retrieve schedule");
        }

        meetings = await meetingResponse.json();
        blocks = await blockResponse.json();

        errorLabel.textContent = "";
        renderCalendar();
      } catch (error) {
        console.error("Calendar loading error:", error);
        errorLabel.textContent = "Could not load schedule data.";
      }
    }

    renderCalendar();
    loadCalendarData();
  }

  document.addEventListener("turbo:load", initializeMediatorCalendar);
})();
</script>
