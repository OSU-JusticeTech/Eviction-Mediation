<div class="bg-white/10 rounded-2xl p-5 backdrop-blur-sm w-full max-w-sm flex-shrink-0">

  <%# Header %>
  <div class="flex items-center justify-between mb-1">
    <div class="flex items-center gap-2 text-white/60 text-xs uppercase tracking-widest font-semibold">
      <i class="fas fa-comment-dots text-white/40"></i>
      Active Negotiations
    </div>
    <span class="text-white/40 text-xs font-medium">
      <%= @landlord_active_conversations.length %> active
    </span>
  </div>

  <p class="text-white/40 text-xs mb-4">Most recently active conversations</p>

  <%# Conversation rows %>
  <div class="flex flex-col gap-1.5 mb-4">
    <% @landlord_active_conversations.each do |mediation| %>
      <% last_msg_at = mediation.linked_message_string&.LastMessageSentDate %>
      <%= link_to message_path(mediation.ConversationID),
            class: "flex items-center justify-between bg-white/10 hover:bg-white/20 rounded-xl px-3 py-2.5 transition-all group" do %>
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-white text-xs font-bold flex-shrink-0 uppercase">
            <%= mediation.tenant.display_name.first %>
          </div>
          <span class="text-white text-sm font-medium truncate"><%= mediation.tenant.display_name %></span>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0 ml-2">
          <% if last_msg_at %>
            <span class="text-white/40 text-xs whitespace-nowrap"><%= time_ago_in_words(last_msg_at) %> ago</span>
          <% else %>
            <span class="text-white/30 text-xs italic whitespace-nowrap">No messages</span>
          <% end %>
          <i class="fas fa-chevron-right text-white/30 text-xs group-hover:text-white/60 transition-colors"></i>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= link_to messages_path,
        class: "flex items-center justify-between bg-white text-[#102a4d] text-sm font-bold px-4 py-3 rounded-full hover:bg-white/90 transition-colors" do %>
    <span>View all conversations</span>
    <i class="fas fa-arrow-right text-xs"></i>
  <% end %>

</div>
