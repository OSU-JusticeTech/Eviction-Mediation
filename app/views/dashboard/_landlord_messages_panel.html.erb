<div class="bg-white/10 rounded-2xl p-5 backdrop-blur-sm w-full max-w-sm flex-shrink-0 border-l-4 border-[#1c7030]">

  <%# Header %>
  <div class="flex items-center justify-between mb-1">
    <div class="flex items-center gap-2 text-white text-xs uppercase tracking-widest font-semibold">
      <i class="fas fa-comment-dots text-[#4ade80]"></i>
      Active Negotiations
    </div>
    <span class="bg-[#e3f5e9] text-[#1c7030] text-xs font-bold uppercase tracking-wide px-2.5 py-0.5 rounded-full">
      <%= @landlord_active_conversations.length %> active
    </span>
  </div>

  <p class="text-white/85 text-xs mb-4">Most recent active conversations</p>

  <%# Conversation rows %>
  <div class="flex flex-col gap-1.5 mb-4">
    <% @landlord_active_conversations.each do |mediation| %>
      <% last_msg_at = mediation.linked_message_string&.LastMessageSentDate %>
      <%= link_to message_path(mediation.ConversationID),
            class: "flex items-center justify-between bg-[#1c7030]/10 border border-[#1c7030]/20 hover:bg-[#1c7030]/20 rounded-xl px-3 py-2.5 transition-all group" do %>
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-7 h-7 rounded-full bg-[#1c7030]/30 flex items-center justify-center text-[#a7f3c0] text-xs font-bold flex-shrink-0 uppercase">
            <%= mediation.tenant.display_name.first %>
          </div>
          <span class="text-white text-sm font-medium truncate"><%= mediation.tenant.display_name %></span>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0 ml-2">
          <% if last_msg_at %>
            <span class="text-white/90 text-xs whitespace-nowrap"><%= time_ago_in_words(last_msg_at) %> ago</span>
          <% else %>
            <span class="text-white/80 text-xs italic whitespace-nowrap">No messages</span>
          <% end %>
          <i class="fas fa-chevron-right text-white/70 text-xs group-hover:text-white transition-colors"></i>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= link_to messages_path,
        class: "flex items-center justify-between bg-white text-[#102a4d] text-sm font-bold px-4 py-3 rounded-full hover:bg-white/90 transition-colors" do %>
    <span>View all conversations</span>
    <i class="fas fa-arrow-right text-xs"></i>
  <% end %>

</div>
