<!-- Quick Actions -->
<div class="action-cards-grid">
  <%= render "action_card", path: messages_path, icon: "fa-envelope-open-text",
        title: "Messages", description: "Respond to tenant requests and manage negotiations",
        label: "View Messages" %>

  <%= render "action_card", path: documents_path, icon: "fa-file-contract",
        title: "Documents", description: "Access agreements and important documentation",
        label: "View Documents" %>

  <%= render "action_card", path: resources_path, icon: "fa-book-open",
        title: "Resources", description: "Learn about mediation best practices and legal guidance",
        label: "Explore Resources" %>

  <%= render "action_card", path: account_path, icon: "fa-user-tie",
        title: "Account", description: "Update your profile and company information",
        label: "Manage Account" %>
</div>

<!-- Property Management Guide -->
<div class="info-section">
  <div class="info-header">
    <h2><i class="fas fa-handshake"></i> Effective Mediation</h2>
    <p>Resolve tenant disputes efficiently while maintaining positive relationships and avoiding costly legal proceedings.</p>
  </div>

  <div class="process-steps">
    <div class="step">
      <div class="step-number">1</div>
      <div class="step-content">
        <h4>Start Conversation or Receive Tenant Request</h4>
        <p>Initiate conversations with tenants or respond promptly to tenant requests showing good faith in resolving the issue.</p>
      </div>
    </div>

    <div class="step">
      <div class="step-number">2</div>
      <div class="step-content">
        <h4>Engage in Dialogue</h4>
        <p>Work directly with tenants to understand their concerns and explore mutually beneficial solutions.</p>
      </div>
    </div>

    <div class="step">
      <div class="step-number">3</div>
      <div class="step-content">
        <h4>Use Mediation When Needed</h4>
        <p>If direct negotiation stalls, request a neutral mediator to help facilitate productive discussions.</p>
      </div>
    </div>
  </div>
</div>

<!-- Benefits Highlight -->
<div class="highlight-section landlord-highlight">
  <div class="highlight-content">
    <h3><i class="fas fa-chart-line" aria-hidden="true"></i> Benefits of Mediation</h3>
    <ul class="benefits-list">
      <li class="benefit-item">
        <i class="fas fa-clock" aria-hidden="true"></i>
        <span>Faster resolution than court proceedings</span>
      </li>
      <li class="benefit-item">
        <i class="fas fa-dollar-sign" aria-hidden="true"></i>
        <span>Lower costs than legal action</span>
      </li>
      <li class="benefit-item">
        <i class="fas fa-user-friends" aria-hidden="true"></i>
        <span>Preserves landlord-tenant relationships</span>
      </li>
      <li class="benefit-item">
        <i class="fas fa-balance-scale" aria-hidden="true"></i>
        <span>Fair outcomes for all parties</span>
      </li>
    </ul>
  </div>
  <div class="highlight-visual">
    <i class="fas fa-building"></i>
  </div>
</div>
