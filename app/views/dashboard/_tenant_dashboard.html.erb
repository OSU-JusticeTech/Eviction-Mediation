<!-- Quick Actions -->
<div class="action-cards-grid">
  <%= render "action_card", path: messages_path, icon: "fa-comments",
        title: "Messages", description: "Start or continue negotiations with your landlord",
        label: "View Messages" %>

  <%= render "action_card", path: resources_path, icon: "fa-book-open",
        title: "Resources", description: "Learn about mediation, your rights, and get help",
        label: "Explore Resources" %>

  <%= render "action_card", path: documents_path, icon: "fa-file-alt",
        title: "Documents", description: "Manage your agreements and important files",
        label: "View Documents" %>

  <%= render "action_card", path: account_path, icon: "fa-user-cog",
        title: "Account", description: "Update your profile and settings",
        label: "Manage Account" %>
</div>

<!-- Getting Started Guide -->
<div class="info-section">
  <div class="info-header">
    <h2><i class="fas fa-lightbulb"></i> Getting Started</h2>
    <p>New to eviction mediation? Here's how to get help resolving your housing dispute.</p>
  </div>

  <div class="process-steps">
    <div class="step">
      <div class="step-number">1</div>
      <div class="step-content">
        <h4>Start a Conversation or Respond to Request</h4>
        <p>Use the Messages page to initiate a discussion with your landlord about your situation or respond to a coversation request by your landlord.</p>
      </div>
    </div>

    <div class="step">
      <div class="step-number">2</div>
      <div class="step-content">
        <h4>Request Mediation</h4>
        <p>If direct negotiation isn't working, request a neutral mediator to help facilitate the conversation.</p>
      </div>
    </div>

    <div class="step">
      <div class="step-number">3</div>
      <div class="step-content">
        <h4>Reach Agreement</h4>
        <p>Work together to find a solution that works for both parties and avoid eviction proceedings.</p>
      </div>
    </div>
  </div>
</div>

<!-- Resources Highlight -->
<div class="highlight-section">
  <div class="highlight-content">
    <h3><i class="fas fa-graduation-cap"></i> Learn About Your Rights</h3>
    <p>Understanding tenant rights and the mediation process can help you achieve better outcomes. Our comprehensive resources include guides, videos, and FAQs.</p>
    <%= link_to "Access Learning Center", resources_path, class: "highlight-btn" %>
  </div>
  <div class="highlight-visual">
    <i class="fas fa-shield-alt"></i>
  </div>
</div>
