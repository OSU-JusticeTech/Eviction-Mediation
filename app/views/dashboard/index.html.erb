<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-store">
<% end %>

<div class="modern-dashboard">
  <!-- Hero Section -->
  <div class="dashboard-hero">
    <div class="hero-content">
      <div class="welcome-section">
        <h1 class="welcome-title">Hello, <%= @user.FName %></h1>
        <p class="welcome-subtitle">
          <% case @user.Role %>
            <% when "Tenant" %>
              Your tenant portal for eviction mediation and resources
            <% when "Landlord" %>
              Your landlord portal for property management and mediation
            <% when "Admin" %>
              Administrative dashboard for managing mediations
            <% when "Mediator" %>
              Your mediation cases and availability center
          <% end %>
        </p>

        <%# Tenants and landlords always get a right panel (active or empty-state CTA) %>
        <% has_right_panel = @user.tenant? || @user.landlord? %>
        <% if has_right_panel %>
          <div class="role-badge <%= @user.Role.downcase %>-badge" style="margin-top: 1rem; display: inline-flex; align-self: flex-start;">
            <i class="fas <%= @user.tenant? ? 'fa-home' : 'fa-building' %>"></i>
            <%= @user.Role %>
          </div>
        <% end %>
      </div>

      <%# Right side: active → pending → empty-state CTA, or role badge for other roles %>
      <% if @user.tenant? && @active_mediation.present? %>
        <%= render "tenant_messages_panel" %>
      <% elsif @user.tenant? && @pending_mediation.present? %>
        <%= render "tenant_pending_panel" %>
      <% elsif @user.tenant? %>
        <%= render "tenant_no_negotiation_panel" %>
      <% elsif @user.landlord? && @landlord_active_conversations.present? %>
        <%= render "landlord_messages_panel" %>
      <% elsif @user.landlord? && @landlord_pending_conversations.present? %>
        <%= render "landlord_pending_panel" %>
      <% elsif @user.landlord? %>
        <%= render "landlord_no_negotiation_panel" %>
      <% else %>
        <div class="role-badge <%= @user.Role.downcase %>-badge">
          <i class="fas <%= case @user.Role
            when 'Admin' then 'fa-shield-alt'
            when 'Mediator' then 'fa-balance-scale'
            end %>"></i>
          <%= @user.Role %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Dashboard Content -->
  <div class="dashboard-content">
    
    <%# Zoom Banner for Tenants and Landlords %>
    <% if @user.tenant? || @user.landlord? %>
      <% 
        # Find all conversations involving this user, then check for active upcoming meetings
        conversation_ids = PrimaryMessageGroup.where(TenantID: @user.UserID).or(PrimaryMessageGroup.where(LandlordID: @user.UserID)).pluck(:ConversationID)
        active_meeting = MediatorScheduledMeeting.where(ConversationID: conversation_ids, Status: "scheduled").where("EndTime > ?", Time.current).order(:StartTime).first 
      %>

      <% if active_meeting&.ZoomLink.present? %>
        <div class="upcoming-meeting" style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 16px; border-radius: 8px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
          <div>
            <h4 style="margin: 0 0 4px 0; color: #1e3a8a; font-size: 1.05rem; font-weight: 600;">
              <i class="fa-solid fa-video"></i> Upcoming Mediation Session
            </h4>
            <p style="margin: 0; color: #2563eb; font-size: 0.9rem; font-weight: 500;">
              <%= active_meeting.StartTime.in_time_zone.strftime("%b %-d, %Y at %-l:%M %p %Z") %>
            </p>
          </div>
          
          <%= link_to "<i class='fa-solid fa-arrow-up-right-from-square'></i> Join Zoom Meeting".html_safe, 
                      active_meeting.ZoomLink, 
                      target: "_blank", 
                      rel: "noopener", 
                      style: "background: #2563eb; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: background 0.2s; white-space: nowrap;" %>
        </div>
      <% end %>
    <% end %>

    <% case @user.Role %>
      <% when "Landlord" %>
        <%= render "landlord_dashboard" %>
      <% when "Tenant" %>
        <%= render "tenant_dashboard" %>
      <% when "Admin" %>
        <%= render "admin_dashboard" %>
      <% when "Mediator" %>
        <%= render "mediator_dashboard" %>
      <% else %>
        <div class="error-card">
          <i class="fas fa-exclamation-triangle"></i>
          <p>Error: User has an invalid role.</p>
        </div>
    <% end %>
  </div>
</div>