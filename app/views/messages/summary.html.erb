<%= stylesheet_link_tag "admin_mediations", "data-turbo-track": "reload" %>

<div class="admin-mediation-details-container">
  <!-- Header -->
  <div class="page-header">
    <% back_path = case @user.Role
                   when "Mediator"
                     third_party_mediations_path
                   when "Admin"
                     dashboard_path
                   else
                     messages_path
                   end %>
    <%= link_to back_path, class: "back-link" do %>
      <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
    <% end %>
    <h1>Mediation Summary</h1>
  </div>

  <div class="details-grid">
    <!-- Left Column: Info & Parties -->
    <div class="details-column left-column">
      
      <!-- Mediation Status -->
      <div class="info-card">
        <div class="card-header">
          <h2><i class="fa-solid fa-info-circle"></i> Status</h2>
        </div>
        <div class="card-body">
          <div class="info-row">
            <span class="label">Ended At</span>
            <span class="value"><%= @mediation.deleted_at&.strftime("%B %d, %Y at %I:%M %p") %></span>
          </div>
          <% if @ended_by %>
            <div class="info-row">
              <span class="label">Ended By</span>
              <span class="value"><%= @ended_by.FName %> <%= @ended_by.LName %> (<%= @ended_by.Role %>)</span>
            </div>
          <% end %>

          <%= render "messages/outcome_control", mediation: @mediation, context: "summary" %>

          <div class="screening-section" style="margin-top: 1.5rem;">
            <h3>Feedback</h3>
            <div class="screening-grid">
              <% if @user.Role == "Landlord" || @user.Role == "Mediator" || @user.Role == "Admin" %>
                <div class="screening-item full-width">
                  <span class="q-label">Tenant acted in good faith (per landlord)</span>
                  <% landlord_survey = @survey_responses.find { |r| r.user&.Role == "Landlord" } %>
                  <span class="q-value"><%= landlord_survey&.good_faith ? landlord_survey.good_faith.titleize : "Pending" %></span>
                </div>
              <% end %>
              
              <% if @user.Role == "Tenant" || @user.Role == "Mediator" || @user.Role == "Admin" %>
                <div class="screening-item full-width">
                  <span class="q-label">Landlord acted in good faith (per tenant)</span>
                  <% tenant_survey = @survey_responses.find { |r| r.user&.Role == "Tenant" } %>
                  <span class="q-value"><%= tenant_survey&.good_faith ? tenant_survey.good_faith.titleize : "Pending" %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Parties -->
      <div class="info-card">
        <div class="card-header">
          <h2><i class="fa-solid fa-users"></i> Parties</h2>
        </div>
        <div class="card-body">
          <!-- Tenant -->
          <div class="party-section" style="margin-bottom: 1.5rem;">
            <h3 style="font-size: 0.9rem; text-transform: uppercase; color: #64748b; margin-bottom: 0.5rem;">Tenant</h3>
            <% if @tenant %>
              <div class="info-row">
                <span class="label">Name</span>
                <span class="value"><%= @tenant.FName %> <%= @tenant.LName %></span>
              </div>
              <div class="info-row">
                <span class="label">Email</span>
                <span class="value"><%= @tenant.Email %></span>
              </div>
            <% else %>
              <p class="text-muted">Tenant information unavailable.</p>
            <% end %>
          </div>

          <!-- Landlord -->
          <div class="party-section" style="margin-bottom: 1.5rem; border-top: 1px solid #e2e8f0; padding-top: 1rem;">
            <h3 style="font-size: 0.9rem; text-transform: uppercase; color: #64748b; margin-bottom: 0.5rem;">Landlord</h3>
            <% if @landlord %>
              <div class="info-row">
                <span class="label">Name</span>
                <span class="value"><%= @landlord.FName %> <%= @landlord.LName %></span>
              </div>
              <div class="info-row">
                <span class="label">Email</span>
                <span class="value"><%= @landlord.Email %></span>
              </div>
            <% else %>
              <p class="text-muted">Landlord information unavailable.</p>
            <% end %>
          </div>

          <!-- Mediator -->
          <div class="party-section" style="border-top: 1px solid #e2e8f0; padding-top: 1rem;">
            <h3 style="font-size: 0.9rem; text-transform: uppercase; color: #64748b; margin-bottom: 0.5rem;">Mediator</h3>
            <% if @mediator %>
              <div class="info-row">
                <span class="label">Name</span>
                <span class="value"><%= @mediator.FName %> <%= @mediator.LName %></span>
              </div>
              <div class="info-row">
                <span class="label">Email</span>
                <span class="value"><%= @mediator.Email %></span>
              </div>
            <% else %>
              <p style="color: #64748b; font-style: italic;">No mediator was assigned to this case.</p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Intake Responses -->
      <% if @intake_question || @landlord_intake_question %>
        <div class="info-card">
          <div class="card-header">
            <h2><i class="fa-solid fa-clipboard-list"></i> Intake Responses</h2>
          </div>
          <div class="card-body">

            <!-- Tenant Intake -->
            <% if @intake_question %>
              <h3 style="font-size: 0.9rem; text-transform: uppercase; color: #64748b; margin-bottom: 0.75rem;">Tenant</h3>
              <div class="info-row">
                <span class="label">Reason(s)</span>
                <span class="value"><%= @intake_question.reasons.join(", ") %></span>
              </div>
              <% unless @intake_question.unknown_only? %>
                <% if @intake_question.DescribeCause.present? %>
                  <div class="info-row">
                    <span class="label">Describe Cause</span>
                    <span class="value"><%= @intake_question.DescribeCause %></span>
                  </div>
                <% end %>
                <% if @intake_question.BestOption.present? %>
                  <div class="info-row">
                    <span class="label">Best Option</span>
                    <span class="value"><%= @intake_question.BestOption %></span>
                  </div>
                <% end %>
                <div class="info-row">
                  <span class="label">Receives Section 8</span>
                  <span class="value"><%= @intake_question.Section8? ? "Yes" : "No" %></span>
                </div>
                <% if @intake_question.MoneyOwed.present? %>
                  <div class="info-row">
                    <span class="label">Money Owed</span>
                    <span class="value"><%= number_to_currency(@intake_question.MoneyOwed) %></span>
                  </div>
                <% end %>
                <% if @intake_question.MonthlyRent.present? %>
                  <div class="info-row">
                    <span class="label">Monthly Rent</span>
                    <span class="value"><%= number_to_currency(@intake_question.MonthlyRent) %></span>
                  </div>
                <% end %>
                <% if @intake_question.DateDue.present? %>
                  <div class="info-row">
                    <span class="label">Rent Due</span>
                    <span class="value"><%= @intake_question.DateDue.strftime("%B %d, %Y") %></span>
                  </div>
                <% end %>
                <% if @intake_question.PayableToday.present? %>
                  <div class="info-row">
                    <span class="label">Payable Today</span>
                    <span class="value"><%= number_to_currency(@intake_question.PayableToday) %></span>
                  </div>
                <% end %>
              <% end %>
            <% end %>

            <!-- Landlord Intake -->
            <% if @landlord_intake_question %>
              <h3 style="font-size: 0.9rem; text-transform: uppercase; color: #64748b; margin-bottom: 0.75rem; <%= 'margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e2e8f0;' if @intake_question %>">Landlord</h3>
              <div class="info-row">
                <span class="label">Reason(s)</span>
                <span class="value"><%= @landlord_intake_question.reasons.join(", ") %></span>
              </div>
              <% unless @landlord_intake_question.unknown_only? %>
                <% if @landlord_intake_question.LandlordDescribeCause.present? %>
                  <div class="info-row">
                    <span class="label">Describe Cause</span>
                    <span class="value"><%= @landlord_intake_question.LandlordDescribeCause %></span>
                  </div>
                <% end %>
                <% if @landlord_intake_question.DesiredOutcome.present? %>
                  <div class="info-row">
                    <span class="label">Desired Outcome</span>
                    <span class="value"><%= @landlord_intake_question.DesiredOutcome %></span>
                  </div>
                <% end %>
                <% if @landlord_intake_question.AmountClaimed.present? %>
                  <div class="info-row">
                    <span class="label">Amount Claimed</span>
                    <span class="value"><%= number_to_currency(@landlord_intake_question.AmountClaimed) %></span>
                  </div>
                <% end %>
                <% if @landlord_intake_question.MonthlyRent.present? %>
                  <div class="info-row">
                    <span class="label">Monthly Rent</span>
                    <span class="value"><%= number_to_currency(@landlord_intake_question.MonthlyRent) %></span>
                  </div>
                <% end %>
                <% if @landlord_intake_question.DateDue.present? %>
                  <div class="info-row">
                    <span class="label">Rent Due</span>
                    <span class="value"><%= @landlord_intake_question.DateDue.strftime("%B %d, %Y") %></span>
                  </div>
                <% end %>
                <div class="info-row">
                  <span class="label">Accepts Payment Plan</span>
                  <span class="value"><%= @landlord_intake_question.AcceptPaymentPlan? ? "Yes" : "No" %></span>
                </div>
              <% end %>
            <% end %>

          </div>
        </div>
      <% end %>

      <!-- Signed Documents -->
      <% if @signed_files.any? %>
        <div class="info-card">
          <div class="card-header">
            <h2><i class="fa-solid fa-file-signature"></i> Signed Documents</h2>
          </div>
          <div class="card-body">
            <ul class="signed-documents-list" style="list-style: none; padding: 0; margin: 0;">
              <% @signed_files.each do |file| %>
                <li style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9;">
                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fa-solid fa-file-pdf" style="color: #ef4444;"></i>
                    <%= link_to file.FileName, "/#{file.FileURLPath}", target: "_blank", style: "color: #0f172a; text-decoration: none; font-weight: 500;" %>
                  </div>
                  <span class="badge" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; background: #f1f5f9; border-radius: 4px; color: #64748b;">Signed</span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Right Column: Chat Transcript -->
    <div class="details-column right-column">
      <div class="info-card" style="margin-bottom: 1.5rem; height: calc(60vh - 80px); display: flex; flex-direction: column;">
        <div class="card-header">
          <h2><i class="fa-solid fa-comments"></i> Chat Transcript</h2>
        </div>
        <div class="card-body" style="flex: 1; overflow-y: auto; background: #f8fafc; padding: 1.5rem;">
          <% if @messages.any? %>
            <div class="chat-transcript">
              <% @messages.each do |message| %>
                <% sender = @conversation_participants[message.SenderID] %>
                <% is_me = sender&.UserID == @user.UserID %>
                <% role = sender&.Role %>
                <% 
                   # Determine Alignment
                   align_class = is_me ? "align-items: flex-end;" : "align-items: flex-start;"
                   bubble_align = is_me ? "align-self: flex-end;" : "align-self: flex-start;"

                   # Determine Color based on Role
                   if role == "Mediator"
                     # Green for Mediator
                     bubble_style = "background: #dcfce7; color: #166534; border: 1px solid #bbf7d0;"
                     attachment_border = "border-top: 1px solid #bbf7d0;"
                   elsif role == "Tenant"
                     # Blue for Tenant
                     bubble_style = "background: #3b82f6; color: white;"
                     attachment_border = "border-top: 1px solid rgba(255,255,255,0.2);"
                   else
                     # White for Landlord (and others)
                     bubble_style = "background: white; border: 1px solid #e2e8f0; color: #0f172a;"
                     attachment_border = "border-top: 1px solid #e2e8f0;"
                   end
                   
                   final_bubble_style = "#{bubble_align} #{bubble_style}"
                %>
                
                <div class="message-wrapper" style="display: flex; flex-direction: column; margin-bottom: 1rem; <%= align_class %>">
                  <div class="message-meta" style="font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.25rem; padding: 0 0.5rem;">
                    <strong><%= sender ? "#{sender.FName} #{sender.LName}" : "Unknown" %></strong>
                    <% if role == "Mediator" %>
                      <span class="badge" style="background: #e0f2fe; color: #0369a1; padding: 0 4px; border-radius: 3px; margin-left: 4px;">Mediator</span>
                    <% end %>
                    • <%= message.MessageDate.strftime("%b %d, %I:%M %p") %>
                  </div>
                  
                  <div class="message-bubble" style="max-width: 80%; padding: 0.75rem 1rem; border-radius: 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); <%= final_bubble_style %>">
                    <%= simple_format(message.Contents, {}, wrapper_tag: "div") %>
                    
                    <% if message.file_attachments.any? %>
                      <div class="attachments" style="margin-top: 0.5rem; padding-top: 0.5rem; <%= attachment_border %>">
                        <% message.file_attachments.each do |attachment| %>
                          <div class="attachment-item" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-paperclip"></i> <%= attachment.file_draft.FileName %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state" style="text-align: center; padding: 3rem; color: #94a3b8;">
              <i class="fa-regular fa-comments" style="font-size: 3rem; margin-bottom: 1rem;"></i>
              <p>No messages were exchanged in this mediation.</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Survey Responses -->
      <% if @survey_responses.any? %>
        <div class="info-card">
          <div class="card-header">
            <h2><i class="fa-solid fa-chart-bar"></i> Survey Responses</h2>
          </div>
          <div class="card-body">
            <% @survey_responses.each_with_index do |response, index| %>
              <% respondent = response.user %>
              <div class="survey-response-section" style="<%= 'margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #e2e8f0;' if index > 0 %>">
                <h3 style="font-size: 0.9rem; text-transform: uppercase; color: #64748b; margin-bottom: 1rem;">
                  Response from <%= respondent ? "#{respondent.FName} #{respondent.LName}#{" (#{response.user_role})" if response.user_role.present?}" : "Unknown" %>
                </h3>
                
                <div class="survey-answers" style="display: grid; gap: 1rem;">
                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">User Role:</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.user_role %></span>
                  </div>

                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">How easy was the tool to use?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.tool_ease&.humanize %></span>
                  </div>
                  
                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">Was the information clear and easy to understand?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.info_clear&.titleize %></span>
                  </div>
                  
                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">Did you understand what mediation is after using this tool?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.understood_mediation&.titleize %></span>
                  </div>
                  
                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">Did the other party participate in the conversation?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.other_participated&.humanize %></span>
                  </div>
                  
                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">Did you feel the other party acted in good faith?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.good_faith&.titleize %></span>
                  </div>
                  
                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">Did the platform help you communicate your side of the issue?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.helped_communicate&.titleize %></span>
                  </div>
                  
                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">Would you recommend this tool to someone in your situation?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.would_recommend&.titleize %></span>
                  </div>

                  <div class="survey-item">
                    <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">What device did you use today?</span>
                    <span class="q-value" style="display: block; font-weight: 500; color: #0f172a;"><%= response.device_used&.titleize %></span>
                  </div>
                  
                  <% if response.liked_most.present? %>
                    <div class="survey-item" style="margin-top: 0.5rem;">
                      <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.5rem;">What did you like most about the platform?</span>
                      <div style="background: #f8fafc; padding: 0.75rem; border-radius: 6px; border: 1px solid #e2e8f0;">
                        <%= simple_format(response.liked_most, {}, wrapper_tag: "div", style: "color: #475569; font-size: 0.875rem; line-height: 1.5;") %>
                      </div>
                    </div>
                  <% end %>

                  <% if response.should_improve.present? %>
                    <div class="survey-item" style="margin-top: 0.5rem;">
                      <span class="q-label" style="display: block; font-size: 0.875rem; color: #64748b; margin-bottom: 0.5rem;">What should we improve?</span>
                      <div style="background: #f8fafc; padding: 0.75rem; border-radius: 6px; border: 1px solid #e2e8f0;">
                        <%= simple_format(response.should_improve, {}, wrapper_tag: "div", style: "color: #475569; font-size: 0.875rem; line-height: 1.5;") %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
