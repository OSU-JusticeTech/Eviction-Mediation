<div class="mediation-container">
  <div class="tenant-header-card">
    <h1>Tenant Negotiation & Messages</h1>
    <p>Welcome, <%= @user.FName %>! This is the tenant negotiations page.</p>
  </div>

  <div class="mediation-toolbar">
    <%= link_to new_mediation_path, class: "mediation-btn" do %>
      <i class="fas fa-plus" aria-hidden="true"></i> Request New Negotiation
    <% end %>
  </div>

  <% if @show_mediation_view %>
    <%= render "messages/mediation_board",
          grouped_mediations: @grouped_mediations,
          has_past: @has_past_mediations,
          role: "Tenant" %>
  <% else %>
    <p class="mediation-status">No negotiations exist. Click "Request New Negotiation" above to get started.</p>
  <% end %>
</div>
