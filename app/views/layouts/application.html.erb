<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Eviction Mediation Self-Help Tool" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= javascript_importmap_tags %>

    <%= yield :head %>

    <!-- App Icons -->
    <link rel="icon" href="/house.png" type="image/png">
    <link rel="icon" href="/house.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/house.png">

  <%# Main Stylesheet - include per-page styles explicitly so Propshaft/importmap
    and different branches load the expected files. This avoids relying on
    Sprockets `require_tree` which can be brittle across branches. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "base", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "navbar", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "flash", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "login", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "signup", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "dashboard", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "chat", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "messages_tenant", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "messages_landlord", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "screening_questions", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "action", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "mediator_screening_view", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "mediations", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "documents", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "resources", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "account_view", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "notifications", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "admin_mediations", "data-turbo-track": "reload" %>
  <%# Removed fallback to `application.css` to avoid double-link with .erb %>
  <% if Rails.env.test? %>
    <%# Disable CSS animations/transitions for system tests %>
    <style>
      *, *::before, *::after {
        animation-duration: 0s !important;
        animation-delay: 0s !important;
        transition-duration: 0s !important;
        transition-delay: 0s !important;
        scroll-behavior: auto !important;
      }
    </style>
  <% end %>
  </head>

  <body class="site-layout <%= yield :body_class %>">
    <% signup_page = controller_name == "users" && action_name == "new" %>
    <% privacy_faq = controller_name == "resources" && params[:tab] == "faqs" && params[:category] == "data-privacy" %>
    <% if terms_of_use_applies? && controller_name != "terms_of_use" && !privacy_faq %>
      <div hidden data-controller="terms-of-use"
           data-terms-of-use-redirect-url-value="<%= terms_of_use_path(return_to: request.get? ? request.fullpath : dashboard_path) %>"></div>
    <% end %>

    <% unless (controller_name == "sessions" && action_name == "new") || signup_page %>
      <% if current_user %>
        <div class="navbar-container">
          <%= render "shared/navbar" %>
        </div>
        <% if current_time_entry %>
          <%= render "shared/time_tracker", entry: current_time_entry %>
        <% end %>
      <% end %>
    <% end %>

    <main id="main-content">
      <% if flash[:alert] %>
        <div class="flash-message flash-alert" data-controller="flash" data-flash-timeout-value="4500">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="flash-message flash-notice" data-controller="flash" data-flash-timeout-value="4500">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer" data-controller="legal-disclaimer"
            data-action="turbo:before-cache@document->legal-disclaimer#close">
      <nav aria-label="Site policies">
        <%= link_to "Terms of Use", terms_of_use_path, data: { turbo: false } %>
        <%= link_to "Data Privacy", resources_path(tab: "faqs", category: "data-privacy") %>
        <%= button_tag "Legal Disclaimer", type: "button", class: "site-footer__disclaimer",
                       aria: { haspopup: "dialog", controls: "site-legal-disclaimer" },
                       data: { action: "legal-disclaimer#open" } %>
      </nav>
      <dialog id="site-legal-disclaimer" class="policy-panel site-legal-disclaimer" aria-labelledby="site-legal-disclaimer-heading"
              data-legal-disclaimer-target="dialog">
        <header>
          <h2 id="site-legal-disclaimer-heading" class="policy-panel__title">Legal Disclaimer</h2>
          <button type="button" autofocus data-action="legal-disclaimer#close">Close</button>
        </header>
        <div class="policy-panel__scroll" tabindex="0" role="region" aria-label="Disclaimer text">
          <%= render "shared/legal_disclaimer_text" %>
        </div>
      </dialog>
    </footer>
  </body>
</html>
