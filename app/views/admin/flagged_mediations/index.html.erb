<div class="mediation-container">
  <h1>Mediations Dashboard</h1>

  <% if @show_mediation_view %>
    <%= render "messages/mediation_board",
          grouped_mediations: @grouped_mediations,
          has_past: @has_past_mediations,
          show_pending_chip: false,
          group_titles: MessagesHelper::ADMIN_GROUP_TITLES,
          role: "Admin" %>
  <% else %>
    <p class="mediation-status">No mediations found.</p>
  <% end %>
</div>
