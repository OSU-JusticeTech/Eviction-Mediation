<div class="mediation-container" style="min-height: auto; overflow: visible; padding-bottom: 100px;">
  <h1>Your Assigned Mediation Cases</h1>

  <% if @show_mediation_view %>
    <%= render "messages/mediation_board",
          grouped_mediations: @grouped_mediations,
          has_past: @has_past_mediations,
          show_pending_chip: false,
          group_titles: MessagesHelper::MEDIATOR_GROUP_TITLES,
          role: "Mediator" %>
  <% else %>
    <p class="mediation-status">No assigned mediation cases.</p>
  <% end %>
</div>
