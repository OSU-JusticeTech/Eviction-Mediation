# App variables for Docker Compose, defaults in Makefile
# Override in env.mk

# App
RAILS_MASTER_KEY
SECRET_KEY_BASE
RAILS_LOG_TO_STDOUT
RAILS_SERVE_STATIC_FILES
APP_URL
APP_PROTOCOL

# Database
DB_ADAPTER
DB_HOST
DB_PORT
DB_USERNAME
DB_PASSWORD

# SMTP
SMTP_ADDRESS
SMTP_PORT
SMTP_AUTHENTICATION
SMTP_ENABLE_STARTTLS_AUTO
SMTP_DOMAIN
SMTP_USERNAME
SMTP_PASSWORD

# Twilio
TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID
